<% content_for :title, "وصفة — #{@medication.display_name}" %>

<div class="max-w-lg mx-auto p-4">

  <!-- Clinic header -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm text-center mb-4">
    <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-teal-500 to-teal-700 text-white flex items-center justify-center text-2xl font-bold mb-3">
      🏥
    </div>
    <h1 class="text-xl font-bold text-slate-800"><%= @clinic&.display_name || "ClinicApp" %></h1>
    <% if @clinic&.phone.present? %>
      <a href="tel:<%= @clinic.phone %>" class="inline-flex items-center gap-1 mt-2 text-teal-600 font-semibold text-sm">
        📞 <%= @clinic.phone %>
      </a>
    <% end %>
  </div>

  <!-- Medication card -->
  <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm mb-4">
    <div class="text-center mb-4">
      <div class="inline-block bg-teal-50 text-teal-700 px-4 py-1 rounded-full text-sm font-bold">
        وصفة طبية
      </div>
    </div>

    <div class="space-y-2 text-sm mb-4">
      <div class="flex justify-between">
        <span class="text-slate-500">المريض:</span>
        <span class="font-semibold text-slate-800"><%= @patient&.display_name || "—" %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">الطبيب:</span>
        <span class="font-semibold text-slate-800">د. <%= @doctor&.name || "—" %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">التاريخ:</span>
        <span class="font-semibold text-slate-800"><%= @medication.created_at.strftime("%Y-%m-%d") %></span>
      </div>
    </div>

    <!-- Medication details -->
    <div class="border-t border-slate-200 pt-4">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center text-lg font-bold shrink-0">
          💊
        </div>
        <div class="flex-1 min-w-0">
          <div class="font-bold text-slate-800 text-lg"><%= @medication.display_name %></div>
          <% if @medication.name_ar.present? && @medication.name.present? %>
            <div class="text-xs text-slate-500"><%= @medication.name %></div>
          <% end %>

          <div class="grid grid-cols-2 gap-3 mt-3 text-sm">
            <div>
              <div class="text-xs text-slate-500">الجرعة</div>
              <div class="font-semibold text-slate-700"><%= @medication.dosage %></div>
            </div>
            <% if @medication.frequency.present? %>
              <div>
                <div class="text-xs text-slate-500">التكرار</div>
                <div class="font-semibold text-slate-700"><%= @medication.frequency %></div>
              </div>
            <% end %>
            <% if @medication.duration.present? %>
              <div>
                <div class="text-xs text-slate-500">المدة</div>
                <div class="font-semibold text-slate-700"><%= @medication.duration %></div>
              </div>
            <% end %>
            <% if @medication.route.present? %>
              <div>
                <div class="text-xs text-slate-500">طريقة الاستخدام</div>
                <div class="font-semibold text-slate-700">
                  <%= t("medications.routes.#{@medication.route}", default: @medication.route) %>
                </div>
              </div>
            <% end %>
          </div>

          <% if @medication.instructions.present? %>
            <div class="mt-3 p-3 bg-amber-50 rounded-lg text-sm text-amber-800">
              <span class="font-semibold">💡 تعليمات:</span>
              <%= @medication.instructions %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Call to action -->
  <% if @clinic&.phone.present? %>
    <div class="bg-teal-50 border border-teal-200 rounded-2xl p-5 text-center">
      <div class="text-sm text-teal-800 mb-3">لأي استفسار تواصل مع العيادة</div>
      <a href="tel:<%= @clinic.phone %>"
         class="inline-flex items-center gap-2 bg-teal-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-teal-700">
        📞 اتصل
      </a>
    </div>
  <% end %>

  <div class="text-center mt-6 text-xs text-slate-400">
    هذه الوصفة صادرة إلكترونياً من نظام ClinicApp
    <div class="mt-1">رقم الوصفة: #<%= @medication.id.to_s.rjust(6, "0") %></div>
  </div>

</div>
