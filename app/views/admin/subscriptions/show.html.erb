<% content_for :title, "Subscription ##{@subscription.id}" %>

<div class="max-w-4xl space-y-5">
  <%= link_to "← Subscriptions", admin_subscriptions_path,
        class: "text-sm text-teal-600 hover:underline" %>

  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
    <div class="flex items-start justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Subscription #<%= @subscription.id %></h1>
        <p class="text-slate-500 mt-1">
          Clinic: <%= link_to @subscription.clinic&.display_name, admin_clinic_path(@subscription.clinic),
                class: "text-teal-600 hover:underline" %>
        </p>
      </div>
      <span class="text-sm font-semibold px-3 py-1.5 rounded-full
        <%= @subscription.status == 'pending_payment' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700' %>">
        <%= @subscription.status %>
      </span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6 text-sm">
      <div>
        <div class="text-slate-500">Plan</div>
        <div class="font-semibold text-slate-800"><%= @subscription.plan %></div>
      </div>
      <div>
        <div class="text-slate-500">Status</div>
        <div class="font-semibold text-slate-800"><%= @subscription.status %></div>
      </div>
      <div>
        <div class="text-slate-500">Submitted</div>
        <div class="font-semibold text-slate-800"><%= @subscription.submitted_at&.strftime("%Y-%m-%d %H:%M") || "—" %></div>
      </div>
      <div>
        <div class="text-slate-500">Confirmed by</div>
        <div class="font-semibold text-slate-800"><%= @subscription.confirmed_by&.name || "—" %></div>
      </div>
    </div>
  </div>

  <% if @subscription.pending_payment? %>
    <!-- Payment proof -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-4 border-b border-slate-100">
        <h2 class="font-semibold text-slate-800">📸 Payment Proof</h2>
      </div>

      <div class="p-6 space-y-4">
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <div class="text-slate-500">Method</div>
            <div class="font-semibold"><%= @subscription.payment_method.presence || "—" %></div>
          </div>
          <div>
            <div class="text-slate-500">Reference</div>
            <div class="font-mono"><%= @subscription.transaction_reference.presence || "—" %></div>
          </div>
        </div>

        <% if @subscription.payment_proof_note.present? %>
          <div>
            <div class="text-slate-500 text-sm">Note</div>
            <div class="text-sm"><%= @subscription.payment_proof_note %></div>
          </div>
        <% end %>

        <% if @subscription.payment_proof.attached? %>
          <div>
            <div class="text-slate-500 text-sm mb-2">Receipt image:</div>
            <a href="<%= url_for(@subscription.payment_proof) %>" target="_blank">
              <img src="<%= url_for(@subscription.payment_proof) %>"
                   class="max-w-full rounded-lg border-2 border-slate-200 shadow-sm max-h-[600px]"
                   alt="Payment proof">
            </a>
            <p class="text-xs text-slate-500 mt-2">Click image to open full size</p>
          </div>
        <% else %>
          <div class="text-sm text-amber-600">⚠️ No image attached</div>
        <% end %>
      </div>

      <!-- Confirm / reject -->
      <div class="p-5 bg-slate-50 border-t border-slate-200 flex gap-3 flex-wrap">
        <%= button_to "✅ Confirm Payment & Activate",
              confirm_payment_admin_subscription_path(@subscription),
              method: :patch,
              data: { turbo_confirm: "Confirm this payment and activate the subscription?" },
              class: "bg-emerald-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-emerald-700 cursor-pointer" %>

        <%= button_to "❌ Reject",
              reject_payment_admin_subscription_path(@subscription),
              method: :patch,
              data: { turbo_confirm: "Reject this payment?" },
              class: "bg-rose-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-rose-700 cursor-pointer" %>
      </div>
    </div>
  <% else %>
    <!-- Admin edit -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-semibold text-slate-800 mb-4">Edit</h2>
      <%= form_with model: [:admin, @subscription], method: :patch, class: "space-y-4" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div>
            <%= f.label :plan, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.select :plan, Subscription::PLANS, {}, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
          <div>
            <%= f.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.select :status, Subscription::STATUSES, {}, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
          <div>
            <%= f.label :expires_at, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.date_field :expires_at, value: @subscription.expires_at&.to_date,
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
        </div>
        <%= f.submit "Save",
              class: "bg-slate-800 text-white px-5 py-2 rounded-lg font-semibold hover:bg-slate-900 cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
</div>
