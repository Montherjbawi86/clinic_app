<% content_for :title, t("admin.subscriptions.title") %>

<div class="space-y-5">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <h1 class="text-2xl font-bold text-slate-800">💳 <%= t("admin.subscriptions.title") %></h1>
    <%= form_with url: admin_subscriptions_path, method: :get, class: "flex gap-2" do %>
      <select name="plan" class="border border-slate-300 rounded-lg px-3 py-2 text-sm">
        <option value=""><%= t("admin.subscriptions.filter_plan") %></option>
        <% Subscription::PLANS.each do |p| %>
          <option value="<%= p %>" <%= "selected" if params[:plan] == p %>><%= p %></option>
        <% end %>
      </select>
      <select name="status" class="border border-slate-300 rounded-lg px-3 py-2 text-sm">
        <option value=""><%= t("admin.subscriptions.filter_status") %></option>
        <% Subscription::STATUSES.each do |s| %>
          <option value="<%= s %>" <%= "selected" if params[:status] == s %>><%= s %></option>
        <% end %>
      </select>
      <button type="submit" class="bg-slate-800 text-white px-4 py-2 rounded-lg font-semibold text-sm"><%= t("actions.filter") %></button>
    <% end %>
  </div>

  <% if @pending_count > 0 %>
    <div class="bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 flex items-center gap-3">
      <span class="text-2xl">⏳</span>
      <div class="flex-1">
        <div class="font-bold text-amber-900">
          <%= @pending_count %> payment<%= @pending_count == 1 ? "" : "s" %> waiting for confirmation
        </div>
        <div class="text-sm text-amber-700">Review proof and activate subscriptions</div>
      </div>
      <%= link_to "Review pending",
            admin_subscriptions_path(status: "pending_payment"),
            class: "bg-amber-600 text-white px-4 py-2 rounded-lg font-semibold text-sm hover:bg-amber-700" %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <% Subscription::PLANS.each do |plan| %>
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
        <div class="text-xs text-slate-500"><%= plan %></div>
        <div class="text-2xl font-bold text-slate-800 mt-1"><%= @plan_counts[plan] || 0 %></div>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <% if @subscriptions.any? %>
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-500">
          <tr>
            <th class="text-start px-5 py-3 font-medium">#</th>
            <th class="text-start px-5 py-3 font-medium"><%= t("admin.subscriptions.table.clinic") %></th>
            <th class="text-start px-5 py-3 font-medium"><%= t("admin.subscriptions.table.plan") %></th>
            <th class="text-start px-5 py-3 font-medium"><%= t("admin.subscriptions.table.status") %></th>
            <th class="text-start px-5 py-3 font-medium"><%= t("admin.subscriptions.table.expires") %></th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @subscriptions.each do |s| %>
            <tr class="hover:bg-slate-50 <%= s.pending_payment? ? 'bg-amber-50/40' : '' %>">
              <td class="px-5 py-3 text-slate-500">#<%= s.id %></td>
              <td class="px-5 py-3 font-medium text-slate-800">
                <% if s.clinic %>
                  <%= link_to s.clinic.display_name, admin_clinic_path(s.clinic), class: "hover:text-teal-600" %>
                <% end %>
              </td>
              <td class="px-5 py-3">
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-teal-50 text-teal-700"><%= s.plan %></span>
              </td>
              <td class="px-5 py-3">
                <span class="text-xs font-semibold px-2 py-1 rounded-full
                  <%= s.status == 'pending_payment' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700' %>">
                  <%= s.status %>
                </span>
              </td>
              <td class="px-5 py-3 text-slate-500 text-xs"><%= s.expires_at&.strftime("%Y-%m-%d") || "—" %></td>
              <td class="px-5 py-3 text-end">
                <%= link_to "View", admin_subscription_path(s),
                      class: "text-xs text-teal-600 hover:underline font-semibold" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="p-8 text-center text-slate-400 text-sm"><%= t("admin.subscriptions.empty") %></p>
    <% end %>
  </div>
</div>
