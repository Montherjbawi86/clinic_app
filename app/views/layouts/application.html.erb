<!DOCTYPE html>
<html>
  <head>
    <title>Clinic Management System</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Tailwind Play CDN for Instant Styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-50 font-sans antialiased min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">
    
    <!-- Modern Styled Navigation Bar -->
    <nav class="bg-white border-b border-slate-200 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 h-16 flex justify-between items-center">
        <div class="flex items-center space-x-8">
          <a href="/" class="text-xl font-extrabold text-blue-600 tracking-tight flex items-center gap-2">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            ClinicApp
          </a>
          <% if logged_in? %>
            <div class="hidden md:flex space-x-6">
              <a href="/dashboard" class="text-slate-600 hover:text-blue-600 font-medium transition">Dashboard</a>
              <a href="/dashboard/chat" class="text-slate-600 hover:text-blue-600 font-medium transition">AI Medical Assistant</a>
            </div>
          <% end %>
        </div>
        
        <div class="flex items-center space-x-4">
          <% if logged_in? %>
            <div class="hidden sm:flex items-center space-x-2 bg-slate-100 px-3 py-1.5 rounded-full">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span class="text-sm font-semibold text-slate-700">Dr. <%= current_user.name %></span>
            </div>
            <%= button_to "Log Out", session_path, method: :delete, class: "text-sm bg-rose-50 text-rose-600 border border-rose-200 px-4 py-2 rounded-lg hover:bg-rose-100 font-semibold transition cursor-pointer shadow-sm" %>
          <% else %>
            <a href="/session/new" class="text-sm text-slate-700 hover:text-blue-600 font-semibold px-4 py-2 transition">Log In</a>
            <a href="/registrations/new" class="text-sm bg-blue-600 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-blue-700 transition shadow-md shadow-blue-500/20">Sign Up Free</a>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Main Dynamic Content Wrapper -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 py-8">
      <% if notice.present? %>
        <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 p-4 rounded-r-xl shadow-sm mb-6 flex items-center justify-between">
          <span class="font-medium"><%= notice %></span>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 p-4 rounded-r-xl shadow-sm mb-6 flex items-center justify-between">
          <span class="font-medium"><%= alert %></span>
        </div>
      <% end %>
      
      <%= yield %>
    </main>

    <!-- Professional Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 text-center text-sm text-slate-500">
      <p>&copy; 2026 Clinic Management System. Built with Ruby on Rails & Tailwind CSS.</p>
    </footer>
  </body>
</html>
