<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= I18n.locale == :ar ? 'rtl' : 'ltr' %>">
<head>
  <title><%= content_for?(:title) ? yield(:title) : t("admin.title") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
  <script>
    tailwind.config = { theme: { extend: { fontFamily: { sans: ['"Segoe UI"', '"Tahoma"', '"Arial"', 'sans-serif'] } } } };
  </script>
</head>
<body class="bg-slate-100 min-h-screen">

<div class="flex min-h-screen">

  <!-- Admin sidebar -->
  <aside class="w-64 bg-slate-900 text-slate-200 flex-col shrink-0 hidden lg:flex">
    <div class="h-16 flex items-center px-5 border-b border-slate-800">
      <span class="flex items-center gap-2 text-white font-extrabold text-lg">
        <span class="text-amber-400">👑</span> <%= t("admin.title") %>
      </span>
    </div>

    <nav class="flex-1 px-3 py-4 space-y-1">
      <%= link_to admin_root_path,
            class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition #{current_page?(admin_root_path) ? 'bg-amber-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
        <span>📊</span> <span><%= t("admin.nav.dashboard") %></span>
      <% end %>

      <%= link_to admin_users_path,
            class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition #{request.path.start_with?(admin_users_path) ? 'bg-amber-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
        <span>👥</span> <span><%= t("admin.nav.users") %></span>
      <% end %>

      <%= link_to admin_clinics_path,
            class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition #{request.path.start_with?(admin_clinics_path) ? 'bg-amber-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
        <span>🏥</span> <span><%= t("admin.nav.clinics") %></span>
      <% end %>

      <%= link_to admin_subscriptions_path,
            class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition #{request.path.start_with?(admin_subscriptions_path) ? 'bg-amber-500 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}" do %>
        <span>💳</span> <span><%= t("admin.nav.subscriptions") %></span>
      <% end %>

      <div class="border-t border-slate-800 my-3"></div>

      <%= link_to dashboard_path,
            class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-white" do %>
        <span>↩</span> <span><%= t("nav.dashboard") %></span>
      <% end %>
    </nav>

    <div class="border-t border-slate-800 p-3">
      <div class="flex items-center gap-3 px-2 py-2">
        <div class="w-9 h-9 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold">
          <%= current_user.name.to_s[0]&.upcase %>
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-semibold text-white truncate"><%= current_user.name %></div>
          <div class="text-xs text-slate-400 truncate">super_admin</div>
        </div>
      </div>
      <%= button_to session_path, method: :delete,
            class: "w-full flex items-center gap-2 px-3 py-2 text-sm text-rose-400 hover:bg-slate-800 rounded-lg mt-2" do %>
        <span>🚪</span> <span><%= t("nav.logout") %></span>
      <% end %>
    </div>
  </aside>

  <!-- Main content -->
  <div class="flex-1 flex flex-col min-w-0">
    <header class="sticky top-0 z-30 h-16 bg-white border-b border-slate-200 flex items-center px-6 gap-4">
      <div class="font-semibold text-slate-800"><%= content_for?(:title) ? yield(:title) : t("admin.title") %></div>
      <div class="ms-auto flex items-center gap-3">
        <div class="flex items-center gap-1 bg-slate-100 rounded-lg p-1">
          <%= button_to "ع",  switch_locale_path(locale: "ar"), method: :post,
                class: "px-2.5 py-1 text-xs font-bold rounded-md #{I18n.locale == :ar ? 'bg-white shadow text-teal-600' : 'text-slate-500'} cursor-pointer" %>
          <%= button_to "EN", switch_locale_path(locale: "en"), method: :post,
                class: "px-2.5 py-1 text-xs font-bold rounded-md #{I18n.locale == :en ? 'bg-white shadow text-teal-600' : 'text-slate-500'} cursor-pointer" %>
        </div>
      </div>
    </header>

    <main class="flex-1 p-6">
      <% [:notice, :alert].each do |type| %>
        <% next unless flash[type].present? %>
        <div class="<%= type.to_sym == :notice ? 'bg-emerald-50 border-emerald-500 text-emerald-800' : 'bg-rose-50 border-rose-500 text-rose-800' %> border-l-4 p-4 rounded-r-xl shadow-sm mb-6">
          <%= flash[type] %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </div>
</div>

</body>
</html>
