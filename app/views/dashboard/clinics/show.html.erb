<% content_for :title, "#{@clinic.display_name} — ClinicApp" %>

<div class="space-y-6">
  <%= link_to "← #{t('clinics.title')}", dashboard_clinics_path, class: "text-sm text-teal-600 hover:underline" %>

  <!-- Header card -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
    <div class="flex flex-col md:flex-row items-start gap-6">

      <!-- Logo -->
      <div class="shrink-0">
        <% if @clinic.logo.attached? %>
          <%= image_tag @clinic.logo, class: "w-24 h-24 rounded-2xl object-cover ring-2 ring-teal-100 shadow-sm" %>
        <% else %>
          <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-teal-500 to-teal-700 text-white flex items-center justify-center text-3xl font-bold shadow-sm">
            <%= @clinic.display_name&.first&.upcase || "🏥" %>
          </div>
        <% end %>
      </div>

      <!-- Info -->
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h1 class="text-2xl font-bold text-slate-800"><%= @clinic.display_name %></h1>
            <% if @clinic.name_ar.present? && @clinic.name.present? %>
              <p class="text-slate-500 mt-1"><%= @clinic.name %></p>
            <% end %>
            <div class="flex flex-wrap gap-2 mt-2">
              <% if @clinic.is_public %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-emerald-100 text-emerald-700">🌐 عام</span>
              <% end %>
              <% if @clinic.city.present? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-slate-100 text-slate-700">📍 <%= @clinic.city %></span>
              <% end %>
              <% if @clinic.specialty.present? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-teal-100 text-teal-700"><%= @clinic.specialty %></span>
              <% end %>
              <% if @clinic.open_now? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-emerald-100 text-emerald-700">🟢 مفتوح الآن</span>
              <% end %>
            </div>
          </div>
          <%= link_to "✏️ تعديل", edit_dashboard_clinic_path(@clinic),
                class: "px-4 py-2 rounded-lg bg-teal-600 text-white font-semibold hover:bg-teal-700 text-sm" %>
        </div>

        <% if @clinic.about_ar.present? || @clinic.about.present? %>
          <p class="text-sm text-slate-600 mt-3"><%= @clinic.about_ar.presence || @clinic.about %></p>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 pt-6 border-t border-slate-100 text-sm">
      <div><div class="text-slate-500">الهاتف</div><div class="font-medium"><%= @clinic.phone.presence || "—" %></div></div>
      <div><div class="text-slate-500">البريد</div><div class="font-medium truncate"><%= @clinic.email.presence || "—" %></div></div>
      <div><div class="text-slate-500">العنوان</div><div class="font-medium"><%= @clinic.address_display.presence || "—" %></div></div>
      <div><div class="text-slate-500">المالك</div><div class="font-medium"><%= @clinic.owner&.name %></div></div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
      <div class="text-sm text-slate-500">👥 المرضى</div>
      <div class="text-3xl font-bold text-slate-800 mt-1"><%= @stats[:patients] %></div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
      <div class="text-sm text-slate-500">📅 مواعيد اليوم</div>
      <div class="text-3xl font-bold text-slate-800 mt-1"><%= @stats[:today_appointments] %></div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
      <div class="text-sm text-slate-500">💰 إيراد الشهر</div>
      <div class="text-2xl font-bold text-emerald-600 mt-1"><%= number_to_currency(@stats[:revenue_month], unit: "SYP ", precision: 0) %></div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
      <div class="text-sm text-slate-500">⏳ مدفوعات معلقة</div>
      <div class="text-2xl font-bold text-amber-600 mt-1"><%= number_to_currency(@stats[:pending_payments], unit: "SYP ", precision: 0) %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Working hours -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
      <div class="p-5 border-b border-slate-200 flex items-center justify-between">
        <h2 class="font-semibold text-slate-800">🕐 ساعات العمل</h2>
        <%= link_to "✏️ تعديل", edit_dashboard_clinic_path(@clinic, anchor: "working-hours"),
              class: "text-sm text-teal-600 hover:underline font-semibold" %>
      </div>
      <ul class="divide-y divide-slate-100">
        <% %w[monday tuesday wednesday thursday friday saturday sunday].each do |day| %>
          <% hours = @clinic.working_hours&.dig(day) %>
          <li class="p-4 flex justify-between text-sm">
            <span class="font-medium text-slate-700"><%= t("days.#{day}", default: day.titleize) %></span>
            <span class="text-slate-600">
              <% if hours && hours["open"].present? %>
                <%= hours["open"] %> — <%= hours["close"] %>
              <% else %>
                <span class="text-rose-500">مغلق</span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Members -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
      <div class="p-5 border-b border-slate-200 flex items-center justify-between">
        <h2 class="font-semibold text-slate-800">👥 الفريق</h2>
        <span class="text-xs text-slate-500"><%= @members.size %> عضو</span>
      </div>

      <ul class="divide-y divide-slate-100">
        <% @members.each do |m| %>
          <li class="p-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-teal-500 text-white flex items-center justify-center text-sm font-bold">
                <%= m.user.name.to_s[0]&.upcase %>
              </div>
              <div>
                <div class="font-medium text-slate-800 text-sm"><%= m.user.name %></div>
                <div class="text-xs text-slate-500"><%= m.user.email %></div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-1 rounded-full bg-slate-100 text-slate-700"><%= m.role %></span>
              <% if m.role != "owner" %>
                <%= button_to "×",
                      remove_member_dashboard_clinic_path(@clinic, member_id: m.id),
                      method: :delete,
                      data: { turbo_confirm: "إزالة هذا العضو؟" },
                      class: "text-rose-600 hover:text-rose-800 font-bold text-lg leading-none cursor-pointer" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <!-- Add member form -->
      <!-- Pending invitations -->
      <% pending = @clinic.clinic_invitations.pending %>
      <% if pending.any? %>
        <div class="border-t border-slate-200 p-4 bg-amber-50">
          <div class="text-xs font-semibold text-amber-800 mb-2">دعوات معلّقة</div>
          <ul class="space-y-1">
            <% pending.each do |inv| %>
              <li class="flex items-center justify-between text-sm">
                <span class="text-amber-900 truncate"><%= inv.email %> <span class="text-xs text-amber-600">(<%= inv.role %>)</span></span>
                <%= button_to "×", dashboard_clinic_clinic_invitation_path(@clinic, inv),
                      method: :delete,
                      data: { turbo_confirm: "إلغاء الدعوة؟" },
                      class: "text-rose-600 hover:text-rose-800 font-bold" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="p-4 border-t border-slate-200 bg-slate-50">
        <div class="text-xs text-slate-500 mb-2">أضف عضواً — إذا لم يكن مسجلاً، سيتم إنشاء دعوة.</div>
        <%= form_with url: dashboard_clinic_clinic_invitations_path(@clinic), method: :post, class: "space-y-2" do %>
          <div class="grid grid-cols-3 gap-2">
            <%= email_field_tag :email, nil, placeholder: "البريد الإلكتروني", required: true,
                  class: "col-span-2 border border-slate-300 rounded-lg px-3 py-2 text-sm" %>
            <%= select_tag :role,
                  options_for_select([["طبيب","doctor"],["ممرض","nurse"],["استقبال","receptionist"],["محاسب","accountant"]]),
                  class: "border border-slate-300 rounded-lg px-2 py-2 text-sm" %>
          </div>
          <%= submit_tag "إضافة / دعوة",
                class: "w-full bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 cursor-pointer text-sm" %>
        <% end %>
      </div>
    </div>

    <!-- Recent activity -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm lg:col-span-2">
      <div class="p-5 border-b border-slate-200">
        <h2 class="font-semibold text-slate-800">📋 النشاط الأخير</h2>
      </div>
      <% if @recent_activity.any? %>
        <ul class="divide-y divide-slate-100">
          <% @recent_activity.each do |a| %>
            <li class="p-4 flex items-center justify-between">
              <div>
                <div class="text-sm font-medium text-slate-800"><%= a.patient&.display_name %></div>
                <div class="text-xs text-slate-500"><%= a.appointment_date %> · <%= a.reason.presence || "—" %></div>
              </div>
              <span class="text-xs font-semibold px-2 py-1 rounded-full bg-teal-50 text-teal-700"><%= a.status %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="p-6 text-sm text-slate-500">لا يوجد نشاط بعد.</p>
      <% end %>
    </div>
  </div>
</div>
