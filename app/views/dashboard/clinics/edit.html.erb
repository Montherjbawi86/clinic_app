<% content_for :title, "تعديل #{@clinic.display_name}" %>

<div class="max-w-3xl mx-auto space-y-6">
  <%= link_to "← #{@clinic.display_name}", dashboard_clinic_path(@clinic), class: "text-sm text-teal-600 hover:underline" %>

  <h1 class="text-2xl font-bold text-slate-800">✏️ تعديل العيادة</h1>

  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
    <%= form_with model: [:dashboard, @clinic], class: "space-y-4", multipart: true do |f| %>
      <% if @clinic.errors.any? %>
        <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 p-3 rounded-r-lg text-sm">
          <%= @clinic.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <!-- Logo -->
      <div class="flex items-center gap-5 pb-4 border-b border-slate-100">
        <% if @clinic.logo.attached? %>
          <%= image_tag @clinic.logo, class: "w-20 h-20 rounded-2xl object-cover ring-2 ring-teal-100" %>
        <% else %>
          <div class="w-20 h-20 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center text-2xl font-bold">🏥</div>
        <% end %>
        <div class="flex-1">
          <%= f.label :logo, "شعار العيادة", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.file_field :logo, accept: "image/*",
                class: "block w-full text-sm text-slate-500 file:me-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, "الاسم (EN)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :name, class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
        </div>
        <div>
          <%= f.label :name_ar, "الاسم (AR)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :name_ar, dir: "rtl", class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
        </div>
        <div>
          <%= f.label :phone, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :phone, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.email_field :email, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :city, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :city, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :specialty, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :specialty, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :address, "العنوان (EN)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :address, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :address_ar, "العنوان (AR)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :address_ar, dir: "rtl", class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :about_ar, "نبذة (AR)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :about_ar, dir: "rtl", rows: 3, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div class="md:col-span-2 flex items-center gap-2">
          <%= f.check_box :is_public, class: "rounded border-slate-300 text-teal-600 focus:ring-teal-500" %>
          <%= f.label :is_public, "عرض العيادة بشكل عام (صفحة حجز للمرضى)", class: "text-sm text-slate-700" %>
        </div>
      </div>

      <!-- Working hours -->
      <div id="working-hours" class="pt-4 border-t border-slate-100 scroll-mt-24">
        <h3 class="font-semibold text-slate-800 mb-3">🕐 ساعات العمل</h3>
        <div class="space-y-2">
          <% %w[monday tuesday wednesday thursday friday saturday sunday].each do |day| %>
            <% hours = @clinic.working_hours&.dig(day) || {} %>
            <div class="grid grid-cols-3 gap-2 items-center">
              <label class="text-sm font-medium text-slate-700"><%= t("days.#{day}", default: day.titleize) %></label>
              <input type="time" name="clinic[working_hours][<%= day %>][open]"  value="<%= hours["open"] %>"
                     class="border border-slate-300 rounded-lg px-3 py-1.5 text-sm">
              <input type="time" name="clinic[working_hours][<%= day %>][close]" value="<%= hours["close"] %>"
                     class="border border-slate-300 rounded-lg px-3 py-1.5 text-sm">
            </div>
          <% end %>
        </div>
        <p class="text-xs text-slate-400 mt-2">اترك الحقلين فارغين ليوم الإغلاق.</p>
      </div>

      <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
        <%= link_to "إلغاء", dashboard_clinic_path(@clinic),
              class: "px-4 py-2 rounded-lg text-slate-700 hover:bg-slate-100 font-semibold" %>
        <%= f.submit "حفظ",
              class: "bg-teal-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-teal-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
