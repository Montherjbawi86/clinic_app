<% content_for :title, "التقويم — ClinicApp" %>
<!-- CALENDAR-STYLES -->
<style>
  .calendar-page { max-width: 1100px; margin: 0 auto; }
  .calendar-grid-wrap { background: white; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; }
  .calendar-dow-header { display: grid; grid-template-columns: repeat(7, 1fr); background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
  .calendar-dow-header > div { padding: 8px 0; text-align: center; font-size: 12px; font-weight: 700; color: #475569; }
  .calendar-week { display: grid; grid-template-columns: repeat(7, 1fr); border-bottom: 1px solid #e2e8f0; }
  .calendar-week:last-child { border-bottom: none; }
  .calendar-cell { padding: 6px; border-left: 1px solid #e2e8f0; height: 72px; overflow: hidden; text-decoration: none; display: block; transition: background 0.15s; }
  .calendar-cell:last-child { border-left: none; }
  .calendar-cell:hover { background: #f8fafc; }
  .calendar-cell.other-month { background: #fafbfc; }
  .calendar-cell.today { background: #f0fdfa; }
  .calendar-cell.closed { background: #f8fafc; }
  .calendar-day-num { font-size: 12px; font-weight: 600; color: #334155; }
  .calendar-day-num.other { color: #cbd5e1; }
  .calendar-day-num.today-badge { width: 20px; height: 20px; background: #0d9488; color: white; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; }
  .calendar-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .calendar-dot.free { background: #10b981; }
  .calendar-dot.full { background: #ef4444; }
  .calendar-appt-line { font-size: 9px; line-height: 1.2; color: #475569; display: flex; align-items: center; gap: 3px; margin-top: 2px; }
  .calendar-appt-line .dot { width: 4px; height: 4px; border-radius: 50%; flex-shrink: 0; }
  .calendar-appt-line .time { font-weight: 600; }
  .calendar-appt-line .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .calendar-more { font-size: 8px; color: #94a3b8; padding-right: 8px; }

  @media (min-width: 1024px) {
    .calendar-page { max-width: 1000px; }
  }
</style>


<%
  month_names = {
    1 => "يناير", 2 => "فبراير", 3 => "مارس", 4 => "أبريل",
    5 => "مايو",  6 => "يونيو",  7 => "يوليو", 8 => "أغسطس",
    9 => "سبتمبر", 10 => "أكتوبر", 11 => "نوفمبر", 12 => "ديسمبر"
  }
  # Week starts on Saturday (Arab week)
  day_names = ["السبت", "الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة"]

  prev_start = (@start_date - 1.month).beginning_of_month
  next_start = (@start_date + 1.month).beginning_of_month
%>

<div class="max-w-5xl mx-auto space-y-3">

  <!-- ============================================================
       TOOLBAR
       ============================================================ -->
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <div class="flex items-center bg-white border border-slate-200 rounded-lg shadow-sm">
        <%= link_to dashboard_calendar_path(start: prev_start, doctor_id: @selected_doctor),
              class: "w-8 h-8 flex items-center justify-center text-slate-500 hover:bg-slate-50 rounded-s-lg border-e border-slate-200" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>

        <span class="px-4 py-1.5 text-sm font-bold text-slate-800 min-w-[120px] text-center">
          <%= month_names[@start_date.month] %> <%= @start_date.year %>
        </span>

        <%= link_to dashboard_calendar_path(start: next_start, doctor_id: @selected_doctor),
              class: "w-8 h-8 flex items-center justify-center text-slate-500 hover:bg-slate-50 rounded-e-lg" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>

      <%= link_to "اليوم",
            dashboard_calendar_path(start: Date.current.beginning_of_month, doctor_id: @selected_doctor),
            class: "text-xs font-semibold text-slate-600 hover:text-teal-600 px-3 py-1.5 bg-white border border-slate-200 rounded-lg" %>
    </div>

    <div class="flex items-center gap-2">
      <%= form_with url: dashboard_calendar_path, method: :get do %>
        <%= hidden_field_tag :start, @start_date %>
        <%= select_tag :doctor_id,
              options_for_select([["كل الأطباء", ""]] + @doctors.map { |d| ["د. #{d.name}", d.id] }, @selected_doctor),
              onchange: "this.form.submit()",
              class: "text-xs border border-slate-300 rounded-lg px-2 py-1.5" %>
      <% end %>
      <%= link_to "＋ موعد جديد",
            new_dashboard_appointment_path,
            class: "bg-teal-600 text-white rounded-lg px-3 py-1.5 text-xs font-semibold hover:bg-teal-700 shadow-sm" %>
    </div>
  </div>

  <!-- ============================================================
       CALENDAR — SIMPLE 7-COLUMN WEEK ROWS
       ============================================================ -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">

    <!-- Day-of-week header -->
    <div class="calendar-dow-header">
      <% day_names.each do |day| %>
        <div class="py-2 text-center text-xs font-bold text-slate-600">
          <%= day %>
        </div>
      <% end %>
    </div>

    <%
      month_start = @start_date.beginning_of_month
      month_end   = @start_date.end_of_month

      # Saturday = column 0. Ruby: Sun=0, Mon=1, Tue=2, Wed=3, Thu=4, Fri=5, Sat=6
      # Convert: Sat(6) -> 0, Sun(0) -> 1, Mon(1) -> 2, Tue(2) -> 3, Wed(3) -> 4, Thu(4) -> 5, Fri(5) -> 6
      first_col = (month_start.wday + 1) % 7
      grid_start = month_start - first_col.days

      last_col = (month_end.wday + 1) % 7
      tail = last_col == 6 ? 0 : 6 - last_col
      grid_end = month_end + tail.days

      # Pad to exactly 6 weeks (42 days) so height is consistent
      days = (grid_start..grid_end).to_a
      while days.size < 42
        days << days.last + 1.day
      end
      days = days.first(42)

      weeks = days.each_slice(7).to_a
    %>

    <% weeks.each_with_index do |week, week_index| %>
      <div class="calendar-week">
        <% week.each do |day| %>
          <%
            in_month   = day.month == month_start.month
            is_today   = day == Date.current
            day_appts  = (@appointments_by_date[day] || [])
            appt_count = day_appts.count
            stats      = @day_stats[day]
            is_closed  = in_month && !stats.present?

            free_count = stats ? stats[:free] : 0
            booked     = stats ? stats[:booked].to_i : 0
            is_free    = in_month && stats.present? && free_count > 0
            is_full    = in_month && stats.present? && free_count == 0 && booked > 0

            bg_class =
              if !in_month then "bg-slate-50/60"
              elsif is_today then "bg-teal-50"
              elsif is_closed then "bg-slate-50"
              else "bg-white hover:bg-slate-50"
              end
          %>

          <a href="/dashboard/calendar/day/<%= day.strftime("%Y-%m-%d") %>"
             class="<%= bg_class %> relative p-1.5 transition border-e border-slate-200 last:border-e-0 block" style="height: 72px; min-height: 72px;">

            <!-- Top row: day number + availability indicator -->
            <div class="flex items-start justify-between mb-1">
              <% if is_today %>
                <span class="w-5 h-5 rounded-full bg-teal-600 text-white flex items-center justify-center text-[10px] font-bold leading-none">
                  <%= day.day %>
                </span>
              <% else %>
                <span class="text-xs font-semibold leading-none pt-0.5
                             <%= !in_month ? 'text-slate-300' : (is_closed ? 'text-slate-400' : 'text-slate-700') %>">
                  <%= day.day %>
                </span>
              <% end %>

              <!-- Green dot = free, Red dot = full -->
              <% if is_free %>
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1" title="<%= free_count %> فترة متاحة"></span>
              <% elsif is_full %>
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mt-1" title="ممتلئ"></span>
              <% end %>
            </div>

            <!-- Compact content: count + first appointment time -->
            <% if in_month && appt_count > 0 %>
              <div class="space-y-0.5">
                <% sorted = day_appts.sort_by { |a| a.appointment_time.to_s } %>
                <% first_a = sorted.first %>
                <%
                  chip = case first_a.status
                         when "scheduled"   then "bg-teal-500"
                         when "confirmed"   then "bg-indigo-500"
                         when "checked_in"  then "bg-amber-500"
                         when "in_progress" then "bg-purple-500"
                         when "completed"   then "bg-emerald-500"
                         when "cancelled", "no_show" then "bg-rose-500"
                         else "bg-slate-400"
                         end
                %>
                <div class="flex items-center gap-1 text-[9px] leading-tight text-slate-600 truncate">
                  <span class="w-1 h-1 rounded-full <%= chip %> shrink-0"></span>
                  <span class="font-semibold"><%= first_a.appointment_time&.strftime("%H:%M") %></span>
                  <span class="truncate"><%= first_a.patient&.display_name&.split&.first %></span>
                </div>

                <% if appt_count > 1 %>
                  <div class="text-[9px] text-slate-400 leading-tight ps-2">
                    +<%= appt_count - 1 %> أخرى
                  </div>
                <% end %>
              </div>
            <% end %>
          </a>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Legend -->
  <div class="flex flex-wrap items-center gap-4 text-[11px] text-slate-500 pt-1">
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span> يوم به فترات متاحة
    </span>
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-rose-500"></span> يوم ممتلئ
    </span>
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-teal-600"></span> اليوم
    </span>
    <span class="text-slate-400">|</span>
    <span>انقر على أي يوم لعرض الفترات</span>
  </div>

</div>
