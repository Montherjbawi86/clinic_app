<div class="space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Billing & Payments</h1>
      <p class="text-slate-500 text-sm">Manage clinic financial records and invoices.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-fit">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Record Payment</h2>
      <%= form_with model: [:dashboard, @payment], local: true do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :amount, "Amount ($)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.number_field :amount, step: "0.01", required: true, class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.label :payment_method, "Payment Method", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.select :payment_method, [["Cash", "Cash"], ["Credit Card", "Credit Card"], ["Insurance", "Insurance"]], { prompt: "Select method" }, class: "w-full border border-slate-300 rounded-xl p-3 bg-white outline-none" %>
          </div>
          <div>
            <%= f.label :status, "Status", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.select :status, [["Completed", "completed"], ["Pending", "pending"]], {}, class: "w-full border border-slate-300 rounded-xl p-3 bg-white outline-none" %>
          </div>
          <div>
            <%= f.submit "Save Payment", class: "w-full bg-blue-600 text-white font-semibold p-3 rounded-xl hover:bg-blue-700 transition cursor-pointer shadow-sm" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-4 border-b border-slate-200 bg-slate-50 font-bold text-slate-700">Transaction History</div>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50/50">
            <th class="p-4">Amount</th>
            <th class="p-4">Method</th>
            <th class="p-4">Status</th>
            <th class="p-4">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if @payments.any? %>
            <% @payments.each do |pay| %>
              <tr class="hover:bg-slate-50">
                <td class="p-4 font-semibold text-slate-900">$<%= sprintf('%.2f', pay.amount.to_f) %></td>
                <td class="p-4 text-slate-700"><%= pay.payment_method.presence || "Cash" %></td>
                <td class="p-4"><span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700"><%= pay.status %></span></td>
                <td class="p-4 text-slate-500 text-xs"><%= pay.created_at.strftime("%b %d, %Y") %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="p-8 text-center text-slate-400">No payment records found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
