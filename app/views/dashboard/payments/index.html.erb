<% content_for :title, "المدفوعات — ClinicApp" %>

<div class="space-y-6">

  <!-- Header -->
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">💳 المدفوعات</h1>
      <p class="text-slate-500 mt-1">سجل المدفوعات والإيرادات</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "📄 PDF", dashboard_payments_path(format: :pdf, q: params[:q], filter: @filter),
            target: "_blank",
            class: "px-4 py-2 rounded-lg bg-slate-800 text-white font-semibold hover:bg-slate-900 text-sm" %>
      <%= link_to "📥 CSV", dashboard_payments_path(format: :csv, q: params[:q], filter: @filter),
            class: "px-4 py-2 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold hover:bg-slate-50 text-sm" %>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3">
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">💰 إجمالي المدفوع</div>
      <div class="text-lg font-bold text-emerald-600 mt-1"><%= number_to_currency(@total_paid, unit: "SYP ", precision: 0) %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">⏳ معلّق</div>
      <div class="text-lg font-bold text-amber-600 mt-1"><%= number_to_currency(@total_pending, unit: "SYP ", precision: 0) %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">📅 هذا الشهر</div>
      <div class="text-lg font-bold text-teal-600 mt-1"><%= number_to_currency(@month_paid, unit: "SYP ", precision: 0) %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">☀️ اليوم</div>
      <div class="text-lg font-bold text-sky-600 mt-1"><%= number_to_currency(@today_paid, unit: "SYP ", precision: 0) %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">📊 العدد</div>
      <div class="text-lg font-bold text-slate-800 mt-1"><%= @count_paid %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">📈 المتوسط</div>
      <div class="text-lg font-bold text-slate-800 mt-1"><%= number_to_currency(@average_paid, unit: "SYP ", precision: 0) %></div>
    </div>
  </div>

  <!-- Filter tabs -->
  <div class="flex flex-wrap items-center gap-2">
    <% filters = [
      ["all",      "الكل",       @counts[:all],      "bg-slate-800"],
      ["paid",     "مدفوع",      @counts[:paid],     "bg-emerald-600"],
      ["pending",  "معلّق",      @counts[:pending],  "bg-amber-600"],
      ["failed",   "فشل",        @counts[:failed],   "bg-rose-600"],
      ["refunded", "مسترجع",     @counts[:refunded], "bg-sky-600"],
      ["today",    "اليوم",      @counts[:today],    "bg-teal-600"],
      ["month",    "هذا الشهر",  @counts[:month],    "bg-teal-600"],
    ] %>
    <% filters.each do |key, label, count, active_bg| %>
      <% active = @filter == key %>
      <%= link_to dashboard_payments_path(filter: key, q: params[:q], sort: @sort),
            class: "px-3 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition #{active ? "#{active_bg} text-white shadow-sm" : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'}" do %>
        <%= label %>
        <span class="text-xs px-1.5 py-0.5 rounded-full <%= active ? 'bg-white/20' : 'bg-slate-100 text-slate-600' %>"><%= count %></span>
      <% end %>
    <% end %>
  </div>

  <!-- Search + sort + dates -->
  <div class="bg-white border border-slate-200 rounded-xl p-3">
    <%= form_with url: dashboard_payments_path, method: :get, class: "flex flex-wrap items-center gap-2" do %>
      <%= hidden_field_tag :filter, @filter %>
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="بحث بالمريض، المرجع…"
             class="border border-slate-300 rounded-lg px-3 py-2 text-sm w-56">
      <div class="text-xs text-slate-500">من:</div>
      <%= date_field_tag :from, params[:from], class: "text-xs border border-slate-300 rounded-lg px-2 py-1.5" %>
      <div class="text-xs text-slate-500">إلى:</div>
      <%= date_field_tag :to, params[:to], class: "text-xs border border-slate-300 rounded-lg px-2 py-1.5" %>
      <%= select_tag :method,
            options_for_select([["الكل",""],["نقدي","cash"],["بطاقة","card"],["حوالة","transfer"],["تأمين","insurance"]], params[:method]),
            class: "text-sm border border-slate-300 rounded-lg px-2 py-2" %>
      <%= select_tag :sort,
            options_for_select([["الأحدث","recent"],["الأقدم","oldest"],["الأعلى","highest"],["الأدنى","lowest"]], @sort),
            class: "text-sm border border-slate-300 rounded-lg px-2 py-2" %>
      <%= submit_tag "بحث", class: "bg-slate-800 text-white px-4 py-2 rounded-lg font-semibold text-sm cursor-pointer" %>
      <% if params[:q].present? || params[:from].present? || params[:to].present? || params[:method].present? %>
        <%= link_to "مسح", dashboard_payments_path(filter: @filter), class: "text-xs text-slate-500 hover:text-slate-700" %>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Record form -->
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm lg:col-span-1 h-fit">
      <h2 class="font-semibold text-slate-800 mb-4">💳 تسجيل دفعة</h2>

      <%= form_with model: [:dashboard, @payment], class: "space-y-3" do |f| %>
        <% if @payment.errors.any? %>
          <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 p-3 rounded-r-lg text-sm">
            <%= @payment.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div>
          <%= f.label :patient_id, "المريض", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.collection_select :patient_id, @patients, :id, :display_name,
                { prompt: "اختر المريض (اختياري)" }, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <%= f.label :amount, "المبلغ", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.number_field :amount, step: "0.01", class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
          <div>
            <%= f.label :currency, "العملة", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.select :currency, Payment::CURRENCIES, { selected: "SYP" }, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
        </div>
        <div>
          <%= f.label :method, "طريقة الدفع", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.select :method,
                [["نقدي","cash"],["بطاقة","card"],["حوالة","transfer"],["تأمين","insurance"]],
                { include_blank: true }, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :status, "الحالة", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.select :status, Payment::STATUSES.map { |s| [t("payments.statuses.#{s}", default: s.titleize), s] },
                { selected: "paid" }, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :reference, "المرجع", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :reference, placeholder: "INV-001", class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :notes, "ملاحظات", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :notes, rows: 2, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <%= f.submit "تسجيل الدفعة",
              class: "w-full bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 cursor-pointer" %>
      <% end %>

      <!-- Methods breakdown -->
      <% if @methods_breakdown.any? %>
        <div class="mt-6 pt-4 border-t border-slate-100">
          <div class="text-xs font-semibold text-slate-600 mb-3">📊 حسب طريقة الدفع (هذا الشهر)</div>
          <% @methods_breakdown.each do |method, amount| %>
            <div class="flex justify-between text-xs mb-2">
              <span class="text-slate-600"><%= method.presence || "غير محدد" %></span>
              <span class="font-semibold text-slate-800"><%= number_to_currency(amount, unit: "", precision: 0) %></span>
            </div>
            <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden mb-2">
              <div class="h-full bg-teal-500"
                   style="width: <%= @month_paid > 0 ? (amount / @month_paid * 100).round : 0 %>%"></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm lg:col-span-2 overflow-hidden">
      <% if @payments.any? %>
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-500">
            <tr>
              <th class="text-start px-4 py-3 font-medium">التاريخ</th>
              <th class="text-start px-4 py-3 font-medium">المريض</th>
              <th class="text-start px-4 py-3 font-medium">المبلغ</th>
              <th class="text-start px-4 py-3 font-medium">الطريقة</th>
              <th class="text-start px-4 py-3 font-medium">الحالة</th>
              <th class="text-start px-4 py-3 font-medium">بواسطة</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @payments.each do |p| %>
              <%
                badge = case p.status
                        when "paid"     then ["bg-emerald-50 text-emerald-700", "✅"]
                        when "pending"  then ["bg-amber-50 text-amber-700", "⏳"]
                        when "failed"   then ["bg-rose-50 text-rose-700", "❌"]
                        when "refunded" then ["bg-sky-50 text-sky-700", "↩️"]
                        when "cancelled" then ["bg-slate-100 text-slate-700", "🚫"]
                        else ["bg-slate-100 text-slate-700", "•"]
                        end
                method_label = {
                  "cash" => "💵 نقدي", "card" => "💳 بطاقة",
                  "transfer" => "🏦 حوالة", "insurance" => "🛡️ تأمين",
                  "stripe" => "🌐 Stripe"
                }[p.method] || (p.method.presence || "—")
              %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 text-slate-600 text-xs whitespace-nowrap">
                  <%= p.created_at.strftime("%Y-%m-%d") %>
                  <div class="text-slate-400"><%= p.created_at.strftime("%H:%M") %></div>
                </td>
                <td class="px-4 py-3">
                  <% if p.patient %>
                    <%= link_to p.patient.display_name, dashboard_patient_path(p.patient),
                          class: "font-medium text-slate-800 hover:text-teal-600" %>
                  <% else %>
                    <span class="text-slate-400">—</span>
                  <% end %>
                  <% if p.reference.present? %>
                    <div class="text-xs text-slate-400"><%= p.reference %></div>
                  <% end %>
                </td>
                <td class="px-4 py-3 font-semibold text-slate-800 whitespace-nowrap">
                  <%= p.display_amount %>
                </td>
                <td class="px-4 py-3 text-slate-600 text-xs"><%= method_label %></td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-1 rounded-full <%= badge[0] %>">
                    <%= badge[1] %> <%= t("payments.statuses.#{p.status}", default: p.status) %>
                  </span>
                </td>
                <td class="px-4 py-3 text-slate-600 text-xs"><%= p.user&.name || "—" %></td>
                <td class="px-4 py-3 text-end whitespace-nowrap">
                  <div class="inline-flex gap-1 items-center">
                    <%# Receipt %>
                    <%= link_to receipt_dashboard_payment_path(p, format: :pdf),
                          target: "_blank", title: "إيصال",
                          class: "p-1.5 rounded-lg text-teal-600 hover:bg-teal-50 transition" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                      </svg>
                    <% end %>

                    <%# Status change buttons based on current status %>
                    <% case p.status %>
                    <% when "pending" %>
                      <%= button_to mark_paid_dashboard_payment_path(p), method: :patch,
                            title: "تحديد كمدفوعة",
                            class: "p-1.5 rounded-lg text-emerald-600 hover:bg-emerald-50 transition cursor-pointer" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                      <% end %>
                      <%= button_to refund_dashboard_payment_path(p), method: :patch,
                            data: { turbo_confirm: "استرجاع الدفعة؟" },
                            title: "استرجاع",
                            class: "p-1.5 rounded-lg text-sky-600 hover:bg-sky-50 transition cursor-pointer" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
                        </svg>
                      <% end %>
                    <% when "paid" %>
                      <%= button_to mark_pending_dashboard_payment_path(p), method: :patch,
                            data: { turbo_confirm: "إرجاع الحالة لمعلّقة؟" },
                            title: "إرجاع لمعلّقة",
                            class: "p-1.5 rounded-lg text-amber-600 hover:bg-amber-50 transition cursor-pointer" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      <% end %>
                      <%= button_to refund_dashboard_payment_path(p), method: :patch,
                            data: { turbo_confirm: "استرجاع الدفعة؟" },
                            title: "استرجاع",
                            class: "p-1.5 rounded-lg text-sky-600 hover:bg-sky-50 transition cursor-pointer" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
                        </svg>
                      <% end %>
                    <% when "refunded", "failed" %>
                      <%= button_to mark_paid_dashboard_payment_path(p), method: :patch,
                            title: "إعادة تفعيل كمدفوعة",
                            class: "p-1.5 rounded-lg text-emerald-600 hover:bg-emerald-50 transition cursor-pointer" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                      <% end %>
                    <% end %>

                    <%# Delete %>
                    <%= button_to dashboard_payment_path(p), method: :delete,
                          data: { turbo_confirm: "حذف الدفعة؟" }, title: "حذف",
                          class: "p-1.5 rounded-lg text-slate-300 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="p-16 text-center">
          <div class="text-5xl mb-3">💳</div>
          <div class="text-slate-500 text-sm">
            <% if params[:q].present? %>
              لا نتائج مطابقة
            <% else %>
              لا توجد مدفوعات بعد
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
