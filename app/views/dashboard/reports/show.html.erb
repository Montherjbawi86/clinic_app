<% content_for :title, "تقرير — #{@patient&.display_name}" %>

<div class="max-w-4xl mx-auto space-y-5">

  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-sm text-slate-500">
    <%= link_to "لوحة التحكم", dashboard_path, class: "hover:text-teal-600" %>
    <span>/</span>
    <%= link_to "التقارير", dashboard_reports_path, class: "hover:text-teal-600" %>
    <span>/</span>
    <span class="text-slate-700 font-medium">#<%= @report.id %></span>
  </div>

  <!-- Header card -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 px-6 py-5 text-white">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center text-2xl">
            📋
          </div>
          <div>
            <div class="text-xs font-semibold text-emerald-100 mb-1">تقرير طبي</div>
            <h1 class="text-xl font-bold"><%= @patient&.display_name %></h1>
            <div class="text-sm text-emerald-100 mt-0.5">
              <%= @report.created_at.strftime("%A، %d %B %Y · %H:%M") rescue @report.created_at.strftime("%Y-%m-%d %H:%M") %>
            </div>
          </div>
        </div>

        <div class="flex gap-2 flex-wrap">
          <%= link_to "🖨️ طباعة PDF",
                dashboard_report_path(@report, format: :pdf),
                target: "_blank",
                class: "bg-white/20 hover:bg-white/30 text-white px-3 py-2 rounded-lg font-semibold text-sm" %>
          <%= link_to "📄 PDF بالتفاصيل",
                dashboard_report_path(@report, format: :pdf),
                target: "_blank",
                class: "bg-white text-emerald-700 px-3 py-2 rounded-lg font-semibold text-sm hidden md:inline-block" %>
          <% if @appointment.present? %>
            <%= link_to "🖨️ وصفة PDF",
                  prescription_dashboard_appointment_path(@appointment, format: :pdf),
                  target: "_blank",
                  class: "bg-white text-emerald-700 px-3 py-2 rounded-lg font-semibold text-sm" %>
          <% end %>
          <%= button_to "🗑️ حذف",
                dashboard_report_path(@report),
                method: :delete,
                data: { turbo_confirm: "حذف التقرير؟" },
                class: "bg-white/20 hover:bg-white/30 text-white px-3 py-2 rounded-lg font-semibold text-sm cursor-pointer" %>
        </div>
      </div>
    </div>

    <!-- Meta grid -->
    <div class="p-6 grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <div class="text-xs text-slate-500 mb-1">الطبيب</div>
        <div class="font-semibold text-slate-800">د. <%= @doctor&.name || "—" %></div>
      </div>
      <div>
        <div class="text-xs text-slate-500 mb-1">المريض</div>
        <% if @patient %>
          <%= link_to @patient.display_name, dashboard_patient_path(@patient),
                class: "font-semibold text-teal-600 hover:underline" %>
        <% else %>
          <div class="font-semibold text-slate-400">—</div>
        <% end %>
      </div>
      <% if @patient&.phone.present? %>
        <div>
          <div class="text-xs text-slate-500 mb-1">هاتف المريض</div>
          <a href="tel:<%= @patient.phone %>" class="font-semibold text-slate-800 hover:text-teal-600">
            <%= @patient.phone %>
          </a>
        </div>
      <% end %>
      <% if @appointment.present? %>
        <div>
          <div class="text-xs text-slate-500 mb-1">الموعد</div>
          <%= link_to dashboard_appointment_path(@appointment),
                class: "font-semibold text-teal-600 hover:underline text-xs" do %>
            <%= @appointment.appointment_date %> · <%= format_time(@appointment.appointment_time) %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Main content + QR -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <div class="lg:col-span-2 space-y-4">

      <!-- Diagnosis -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
        <div class="p-5 border-b border-slate-100 flex items-center gap-2">
          <span class="text-lg">🔍</span>
          <h2 class="font-bold text-slate-800">التشخيص</h2>
        </div>
        <div class="p-5 text-slate-700 leading-relaxed whitespace-pre-wrap">
          <%= @report.display_diagnosis.presence || "—" %>
        </div>
      </div>

      <!-- Treatment -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
        <div class="p-5 border-b border-slate-100 flex items-center gap-2">
          <span class="text-lg">💊</span>
          <h2 class="font-bold text-slate-800">العلاج</h2>
        </div>
        <div class="p-5 text-slate-700 leading-relaxed whitespace-pre-wrap">
          <%= @report.display_treatment.presence || "—" %>
        </div>
      </div>

      <!-- Notes -->
      <% if @report.notes.present? || @report.notes_ar.present? %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
          <div class="p-5 border-b border-slate-100 flex items-center gap-2">
            <span class="text-lg">📝</span>
            <h2 class="font-bold text-slate-800">ملاحظات</h2>
          </div>
          <div class="p-5 text-slate-700 leading-relaxed whitespace-pre-wrap">
            <%= @report.notes_ar.presence || @report.notes %>
          </div>
        </div>
      <% end %>

      <!-- Medications from appointment -->
      <% if @medications.any? %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
          <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-lg">💊</span>
              <h2 class="font-bold text-slate-800">الأدوية الموصوفة</h2>
            </div>
            <span class="text-xs text-slate-500"><%= @medications.count %> دواء</span>
          </div>
          <ul class="divide-y divide-slate-100">
            <% @medications.each do |m| %>
              <li class="p-4 flex items-center justify-between hover:bg-slate-50">
                <%= link_to dashboard_medication_path(m),
                      class: "flex-1 min-w-0 hover:text-teal-600" do %>
                  <div class="font-medium text-slate-800 truncate"><%= m.display_name %></div>
                  <div class="text-xs text-slate-500">
                    <%= m.dosage %>
                    <% if m.frequency.present? %> · <%= m.frequency %><% end %>
                    <% if m.duration.present? %> · <%= m.duration %><% end %>
                  </div>
                <% end %>
                <span class="text-xs px-2 py-1 rounded-full
                  <%= m.status == "active" ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600" %>">
                  <%= m.status %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <!-- Right column -->
    <div class="space-y-4">

      <!-- Follow-up card -->
      <% if @report.follow_up_date.present? %>
        <%
          days_until = (@report.follow_up_date - Date.current).to_i
          card_class =
            if days_until < 0 then "border-rose-200 bg-rose-50"
            elsif days_until <= 3 then "border-amber-200 bg-amber-50"
            else "border-teal-200 bg-teal-50"
            end
        %>
        <div class="rounded-2xl border-2 <%= card_class %> p-5 shadow-sm">
          <div class="flex items-center gap-2 text-sm font-semibold text-slate-700 mb-2">
            🔄 موعد المتابعة
          </div>
          <div class="text-lg font-bold text-slate-800">
            <%= @report.follow_up_date.strftime("%Y-%m-%d") %>
          </div>
          <div class="text-xs text-slate-500 mt-1">
            <%= days_until < 0 ? "متأخر #{days_until.abs} يوم" : (days_until == 0 ? "اليوم" : "خلال #{days_until} يوم") %>
          </div>
          <%= link_to "احجز موعد متابعة",
                new_dashboard_appointment_path(
                  patient_id: @patient&.id,
                  appointment_date: @report.follow_up_date,
                  reason: "متابعة"
                ),
                class: "block text-center mt-3 text-xs font-semibold text-teal-600 hover:underline" %>
        </div>
      <% end %>

      <!-- Patient summary -->
      <% if @patient %>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
          <div class="text-xs font-semibold text-slate-500 uppercase mb-3">👤 المريض</div>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold">
              <%= @patient.display_name&.first&.upcase || "؟" %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-semibold text-slate-800 truncate"><%= @patient.display_name %></div>
              <div class="text-xs text-slate-500 truncate">
                <%= @patient.age.presence || @patient.age_from_dob || "—" %> سنة
                <% if @patient.blood_type.present? %> · 🩸 <%= @patient.blood_type %><% end %>
              </div>
            </div>
          </div>
          <% if @patient.allergies.present? %>
            <div class="mt-3 p-2 rounded-lg bg-rose-50 text-xs text-rose-700">
              ⚠️ حساسية: <%= @patient.allergies.truncate(60) %>
            </div>
          <% end %>
          <%= link_to "الملف الكامل ←", dashboard_patient_path(@patient),
                class: "block text-center mt-3 text-xs font-semibold text-teal-600 hover:underline" %>
        </div>
      <% end %>

      <!-- QR (if available) -->
      <% if @report_qr.present? %>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm text-center">
          <div class="text-xs font-semibold text-slate-500 mb-3">📱 رمز التقرير</div>
          <img src="<%= @report_qr %>" style="width: 160px; height: 160px; margin: 0 auto;" alt="QR">
          <div class="text-xs text-slate-500 mt-3">امسح الرمز لعرض التقرير</div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style media="print">
  body { background: white !important; }
  nav, header, footer, button, .no-print { display: none !important; }
  .shadow-sm, .shadow-md { box-shadow: none !important; }
</style>
