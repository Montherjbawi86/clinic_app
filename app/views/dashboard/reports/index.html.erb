<div class="space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Medical Reports</h1>
      <p class="text-slate-500 text-sm">Create and review medical diagnoses and treatment plans.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-fit">
      <h2 class="text-lg font-bold text-slate-900 mb-4">New Medical Report</h2>
      <%= form_with model: [:dashboard, @report], url: dashboard_reports_path, local: true do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :patient_id, "Patient", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.collection_select :patient_id, Patient.all, :id, :name, { prompt: "Choose patient..." }, class: "w-full border border-slate-300 rounded-xl p-3 bg-white outline-none" %>
          </div>
          <div>
            <%= f.label :diagnosis, "Diagnosis", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :diagnosis, required: true, class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.label :prescription, "Prescription", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_area :prescription, rows: 2, class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.label :notes, "Doctor Notes", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_area :notes, rows: 2, class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.submit "Save Report", class: "w-full bg-blue-600 text-white font-semibold p-3 rounded-xl hover:bg-blue-700 transition cursor-pointer shadow-sm" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-4 border-b border-slate-200 bg-slate-50 font-bold text-slate-700">Recent Reports</div>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50/50">
            <th class="p-4">Patient</th>
            <th class="p-4">Diagnosis</th>
            <th class="p-4">Prescription</th>
            <th class="p-4">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if @reports.any? %>
            <% @reports.each do |rep| %>
              <tr class="hover:bg-slate-50">
                <td class="p-4 font-semibold text-slate-800"><%= rep.patient&.name || "N/A" %></td>
                <td class="p-4 text-slate-700 font-medium"><%= rep.diagnosis %></td>
                <td class="p-4 text-slate-600 truncate max-w-xs"><%= rep.prescription.presence || "None" %></td>
                <td class="p-4 text-slate-500 text-xs"><%= rep.created_at.strftime("%b %d, %Y") %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="p-8 text-center text-slate-400">No medical reports found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
