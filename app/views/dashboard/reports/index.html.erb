<% content_for :title, "التقارير الطبية — ClinicApp" %>

<div class="space-y-6">

  <!-- Header -->
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">📋 التقارير الطبية</h1>
      <p class="text-slate-500 mt-1">التقارير والتشخيصات لمرضاك</p>
    </div>
    <div class="flex gap-2 flex-wrap">
      <%= link_to "📄 طباعة / PDF",
            dashboard_reports_path(format: :pdf, q: params[:q], filter: @filter, sort: @sort),
            target: "_blank",
            class: "px-4 py-2 rounded-lg bg-slate-800 text-white font-semibold hover:bg-slate-900 text-sm" %>
      <%= link_to "📥 CSV",
            dashboard_reports_path(format: :csv, q: params[:q], filter: @filter),
            class: "px-4 py-2 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold hover:bg-slate-50 text-sm" %>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">📋 الإجمالي</div>
      <div class="text-2xl font-bold text-slate-800 mt-1"><%= @total_count %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">📅 هذا الشهر</div>
      <div class="text-2xl font-bold text-teal-600 mt-1"><%= @month_count %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">☀️ اليوم</div>
      <div class="text-2xl font-bold text-sky-600 mt-1"><%= @today_count %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">🔄 متابعة</div>
      <div class="text-2xl font-bold text-amber-600 mt-1"><%= @follow_up_count %></div>
    </div>
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">👥 مرضى</div>
      <div class="text-2xl font-bold text-purple-600 mt-1"><%= @unique_patients %></div>
    </div>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap items-center gap-2">
    <% filters = [
      ["all",      "الكل",       @total_count,      "bg-slate-800"],
      ["month",    "هذا الشهر",  @month_count,      "bg-teal-600"],
      ["today",    "اليوم",      @today_count,      "bg-sky-600"],
      ["follow_up","متابعة",     @follow_up_count,  "bg-amber-600"],
    ] %>
    <% filters.each do |key, label, count, active_bg| %>
      <% active = @filter == key %>
      <%= link_to dashboard_reports_path(filter: key, q: params[:q], sort: @sort),
            class: "px-3 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition #{active ? "#{active_bg} text-white shadow-sm" : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'}" do %>
        <%= label %>
        <span class="text-xs px-1.5 py-0.5 rounded-full <%= active ? 'bg-white/20' : 'bg-slate-100 text-slate-600' %>"><%= count %></span>
      <% end %>
    <% end %>

    <div class="ms-auto">
      <%= form_with url: dashboard_reports_path, method: :get, class: "flex gap-2" do %>
        <%= hidden_field_tag :filter, @filter %>
        <input type="text" name="q" value="<%= params[:q] %>" placeholder="ابحث بالتشخيص أو المريض…"
               class="border border-slate-300 rounded-lg px-3 py-2 text-sm w-56">
        <%= select_tag :sort,
              options_for_select([["الأحدث","recent"],["الأقدم","oldest"],["المريض","patient"]], @sort),
              onchange: "this.form.submit()",
              class: "text-sm border border-slate-300 rounded-lg px-2 py-2" %>
        <%= submit_tag "بحث", class: "bg-slate-800 text-white px-4 py-2 rounded-lg font-semibold text-sm cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- New report form -->
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm lg:col-span-1 h-fit lg:sticky lg:top-4">
      <h2 class="font-semibold text-slate-800 mb-4">＋ تقرير جديد</h2>

      <% if @report.patient_id.present? || @report.appointment_id.present? %>
        <div class="mb-3 p-3 bg-teal-50 border border-teal-200 rounded-lg text-sm">
          <div class="text-teal-800 font-semibold">📌 مسودة مرتبطة</div>
          <% if @report.patient %>
            <div class="text-xs text-teal-600 mt-0.5">المريض: <%= @report.patient.display_name %></div>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: @report, url: dashboard_reports_path, method: :post, class: "space-y-3" do |f| %>
        <% if @report.errors.any? %>
          <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 p-3 rounded-r-lg text-sm">
            <%= @report.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div>
          <%= f.label :patient_id, "المريض", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.collection_select :patient_id, @patients, :id, :display_name,
                { prompt: "اختر المريض" },
                class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :appointment_id, "الموعد (اختياري)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.collection_select :appointment_id, @appointments, :id,
                ->(a) { "#{a.appointment_date} — #{a.patient&.display_name}" },
                { prompt: "بدون موعد" },
                class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :diagnosis, "التشخيص", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :diagnosis, rows: 2, placeholder: "التهاب حلق حاد…",
                class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :diagnosis_ar, "التشخيص (AR)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :diagnosis_ar, dir: "rtl", rows: 2,
                class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :treatment, "العلاج", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :treatment, rows: 2, placeholder: "مضاد حيوي + راحة",
                class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :treatment_ar, "العلاج (AR)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :treatment_ar, dir: "rtl", rows: 2,
                class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :notes, "ملاحظات", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :notes, rows: 2, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :follow_up_date, "موعد المتابعة", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.date_field :follow_up_date, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <%= f.hidden_field :status, value: "final" %>
        <%= f.submit "حفظ التقرير",
              class: "w-full bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 cursor-pointer" %>
      <% end %>
    </div>

    <!-- Reports list -->
    <div class="lg:col-span-2 space-y-3">
      <% if @reports.any? %>
        <% @reports.each do |r| %>
          <%
            has_follow_up = r.follow_up_date.present?
            days_until = has_follow_up ? (r.follow_up_date - Date.current).to_i : nil
            follow_up_class =
              if days_until.nil? then "bg-slate-100 text-slate-600"
              elsif days_until < 0 then "bg-rose-100 text-rose-700"
              elsif days_until <= 3 then "bg-amber-100 text-amber-700"
              else "bg-teal-100 text-teal-700"
              end
          %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition overflow-hidden">
            <div class="p-5">

              <!-- Header -->
              <div class="flex items-start justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-3 min-w-0 flex-1">
                  <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-lg shrink-0">
                    📋
                  </div>
                  <div class="min-w-0">
                    <%= link_to dashboard_report_path(r),
                          class: "font-bold text-slate-800 hover:text-teal-600 truncate block text-base" do %>
                      <%= r.patient&.display_name %>
                    <% end %>
                    <div class="text-xs text-slate-500 mt-0.5">
                      د. <%= r.doctor&.name || "—" %>
                      · <%= r.created_at.strftime("%Y-%m-%d %H:%M") %>
                    </div>
                  </div>
                </div>

                <% if has_follow_up %>
                  <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= follow_up_class %>">
                    🔄 <%= days_until < 0 ? "متأخر" : (days_until == 0 ? "اليوم" : "خلال #{days_until} يوم") %>
                  </span>
                <% end %>
              </div>

              <!-- Diagnosis -->
              <div class="mt-4 space-y-2">
                <div class="bg-emerald-50/50 border border-emerald-100 rounded-lg p-3">
                  <div class="text-[11px] font-semibold text-emerald-800 mb-1">🔍 التشخيص</div>
                  <div class="text-sm text-slate-700 leading-snug">
                    <%= r.display_diagnosis.to_s.truncate(200) %>
                  </div>
                </div>

                <% if r.display_treatment.present? %>
                  <div class="bg-sky-50/50 border border-sky-100 rounded-lg p-3">
                    <div class="text-[11px] font-semibold text-sky-800 mb-1">💊 العلاج</div>
                    <div class="text-sm text-slate-700 leading-snug">
                      <%= r.display_treatment.to_s.truncate(180) %>
                    </div>
                  </div>
                <% end %>

                <% if r.follow_up_date.present? %>
                  <div class="flex items-center gap-2 text-xs text-slate-600">
                    <span class="text-slate-400">📅 متابعة:</span>
                    <span class="font-semibold"><%= r.follow_up_date.strftime("%Y-%m-%d") %></span>
                  </div>
                <% end %>
              </div>

              <!-- Actions -->
              <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-100">
                <div class="flex items-center gap-3 text-xs">
                  <% if r.appointment.present? %>
                    <%= link_to "📅 الموعد", dashboard_appointment_path(r.appointment),
                          class: "text-teal-600 hover:underline font-semibold" %>
                  <% end %>
                </div>
                <div class="flex items-center gap-2">
                  <%= link_to "🖨️ PDF", dashboard_report_path(r, format: :pdf),
                        target: "_blank",
                        class: "text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded" %>
                  <%= link_to "عرض ←", dashboard_report_path(r),
                        class: "text-sm font-semibold text-teal-600 hover:text-teal-800" %>
                  <%= button_to "🗑️", dashboard_report_path(r),
                        method: :delete,
                        data: { turbo_confirm: "حذف التقرير؟" },
                        class: "text-slate-300 hover:text-rose-600 cursor-pointer bg-transparent border-0 text-sm" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="bg-white rounded-2xl border-2 border-dashed border-slate-200 p-16 text-center">
          <div class="text-6xl mb-4">📋</div>
          <div class="text-lg font-semibold text-slate-700 mb-2">
            <% if params[:q].present? %>
              لا نتائج مطابقة
            <% else %>
              لا توجد تقارير بعد
            <% end %>
          </div>
          <div class="text-sm text-slate-500">
            <% if params[:q].blank? %>
              ابدأ بإضافة أول تقرير طبي من النموذج على اليسار
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
