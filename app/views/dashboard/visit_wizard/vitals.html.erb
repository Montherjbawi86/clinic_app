<% content_for :title, "القياسات الحيوية — #{@appointment.patient&.display_name}" %>

<div class="max-w-3xl mx-auto p-4">
  <%= render "dashboard/visit_wizard/header" %>

  <%= form_with url: wizard_save_dashboard_appointment_path(@appointment),
                method: :post, class: "space-y-5" do %>
    <%= hidden_field_tag :step, "vitals" %>

    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
        <span class="text-xl">📊</span> القياسات الحيوية
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div>
          <%= label_tag :vitals_bp, "ضغط الدم", class: "block text-xs font-semibold text-slate-600 mb-1" %>
          <div class="flex items-center gap-1.5">
            <%= text_field_tag "vitals[blood_pressure]", @appointment.vitals&.dig("blood_pressure"),
                  placeholder: "120/80", dir: "ltr",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" %>
            <span class="text-[10px] text-slate-400 shrink-0">mmHg</span>
          </div>
        </div>

        <div>
          <%= label_tag :vitals_hr, "النبض", class: "block text-xs font-semibold text-slate-600 mb-1" %>
          <div class="flex items-center gap-1.5">
            <%= text_field_tag "vitals[heart_rate]", @appointment.vitals&.dig("heart_rate"),
                  placeholder: "72", dir: "ltr",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" %>
            <span class="text-[10px] text-slate-400 shrink-0">bpm</span>
          </div>
        </div>

        <div>
          <%= label_tag :vitals_temp, "الحرارة", class: "block text-xs font-semibold text-slate-600 mb-1" %>
          <div class="flex items-center gap-1.5">
            <%= text_field_tag "vitals[temperature]", @appointment.vitals&.dig("temperature"),
                  placeholder: "36.8", dir: "ltr",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" %>
            <span class="text-[10px] text-slate-400 shrink-0">°C</span>
          </div>
        </div>

        <div>
          <%= label_tag :vitals_weight, "الوزن", class: "block text-xs font-semibold text-slate-600 mb-1" %>
          <div class="flex items-center gap-1.5">
            <%= text_field_tag "vitals[weight]", @appointment.vitals&.dig("weight"),
                  placeholder: "75", dir: "ltr",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" %>
            <span class="text-[10px] text-slate-400 shrink-0">kg</span>
          </div>
        </div>

        <div>
          <%= label_tag :vitals_oxygen, "الأكسجين", class: "block text-xs font-semibold text-slate-600 mb-1" %>
          <div class="flex items-center gap-1.5">
            <%= text_field_tag "vitals[oxygen]", @appointment.vitals&.dig("oxygen"),
                  placeholder: "98", dir: "ltr",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" %>
            <span class="text-[10px] text-slate-400 shrink-0">%</span>
          </div>
        </div>

        <div>
          <%= label_tag :vitals_glucose, "السكر", class: "block text-xs font-semibold text-slate-600 mb-1" %>
          <div class="flex items-center gap-1.5">
            <%= text_field_tag "vitals[glucose]", @appointment.vitals&.dig("glucose"),
                  placeholder: "110", dir: "ltr",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500" %>
            <span class="text-[10px] text-slate-400 shrink-0">mg/dL</span>
          </div>
        </div>
      </div>

      <div class="mt-5 space-y-3">
        <div>
          <%= label_tag :visit_notes, "ملاحظات الزيارة", class: "block text-sm font-semibold text-slate-700 mb-1" %>
          <%= text_area_tag :visit_notes, @appointment.visit_notes, rows: 3,
                class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
        </div>
      </div>
    </div>

    <%= render "dashboard/visit_wizard/actions" %>
  <% end %>
</div>
