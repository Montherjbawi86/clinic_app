<% content_for :title, "التقرير الطبي — #{@appointment.patient&.display_name}" %>

<div class="max-w-3xl mx-auto p-4">
  <%= render "dashboard/visit_wizard/header" %>

  <%= form_with url: wizard_save_dashboard_appointment_path(@appointment),
                method: :post, class: "space-y-4" do %>
    <%= hidden_field_tag :step, "report" %>

    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
        <span class="text-xl">📋</span> التقرير الطبي
      </h2>

      <%= fields_for :medical_report, @report do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :diagnosis, "التشخيص", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_area :diagnosis, rows: 3, placeholder: "التهاب حلق حاد",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
          </div>
          <div>
            <%= f.label :treatment, "العلاج", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_area :treatment, rows: 3, placeholder: "مضاد حيوي + راحة",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
          </div>
          <div>
            <%= f.label :notes, "ملاحظات إضافية", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_area :notes, rows: 3,
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
          </div>
        </div>
      <% end %>
    </div>

    <%= render "dashboard/visit_wizard/actions" %>
  <% end %>
</div>
