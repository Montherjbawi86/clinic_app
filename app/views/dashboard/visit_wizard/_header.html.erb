<%
  steps = [
    ["vitals",       "1", "القياسات الحيوية"],
    ["prescription", "2", "الوصفة الطبية"],
    ["report",       "3", "التقرير الطبي"],
    ["followup",     "4", "موعد المتابعة"]
  ]
  current_idx = steps.index { |s| s[0] == @step } || 0
%>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 mb-5">
  <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
    <div>
      <h1 class="text-xl font-bold text-slate-800">🩺 زيارة المريض</h1>
      <p class="text-sm text-slate-500">
        <%= @appointment.patient&.display_name %>
        · <%= @appointment.appointment_date %>
      </p>
    </div>
    <%= link_to "✕ إغلاق",
          dashboard_appointment_path(@appointment),
          class: "text-sm text-slate-500 hover:text-slate-700 font-semibold" %>
  </div>

  <!-- Step indicator -->
  <div class="flex items-center gap-2">
    <% steps.each_with_index do |(key, num, label), idx| %>
      <%
        is_current = key == @step
        is_done = idx < current_idx
        is_future = idx > current_idx
      %>
      <div class="flex items-center gap-2 flex-1">
        <div class="flex items-center gap-2 <%= is_current ? 'text-teal-600' : (is_done ? 'text-emerald-600' : 'text-slate-400') %>">
          <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm
                      <%= is_current ? 'bg-teal-600 text-white shadow-md shadow-teal-500/30' : (is_done ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-400') %>">
            <%= is_done ? "✓" : num %>
          </div>
          <span class="hidden md:inline text-xs font-semibold"><%= label %></span>
        </div>
        <% unless idx == steps.size - 1 %>
          <div class="flex-1 h-0.5 <%= is_done ? 'bg-emerald-400' : 'bg-slate-200' %>"></div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
