<% content_for :title, "الوصفة الطبية — #{@appointment.patient&.display_name}" %>

<div class="max-w-3xl mx-auto p-4">
  <%= render "dashboard/visit_wizard/header" %>

  <!-- Already added medications -->
  <% if @medications.any? %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm mb-4 overflow-hidden">
      <div class="p-4 border-b border-slate-100 bg-slate-50">
        <div class="font-semibold text-slate-700 text-sm">💊 الأدوية المضافة (<%= @medications.count %>)</div>
      </div>
      <ul class="divide-y divide-slate-100">
        <% @medications.each do |m| %>
          <li class="p-4 flex items-center justify-between">
            <div>
              <div class="font-semibold text-slate-800"><%= m.display_name %></div>
              <div class="text-xs text-slate-500"><%= m.dosage %> · <%= m.frequency.presence || "—" %></div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: wizard_save_dashboard_appointment_path(@appointment),
                method: :post, class: "space-y-4" do %>
    <%= hidden_field_tag :step, "prescription" %>

    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
        <span class="text-xl">💊</span> إضافة دواء
      </h2>

      <%= fields_for :medication, @medication do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :name, "اسم الدواء (EN)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :name, placeholder: "Amoxicillin",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
          </div>
          <div>
            <%= f.label :name_ar, "الاسم (AR)", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :name_ar, dir: "rtl", placeholder: "أموكسيسيلين",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
          </div>
          <div>
            <%= f.label :dosage, "الجرعة", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :dosage, placeholder: "500mg",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
          <div>
            <%= f.label :frequency, "التكرار", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :frequency, placeholder: "3x daily",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
          <div>
            <%= f.label :duration, "المدة", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :duration, placeholder: "7 days",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
          <div>
            <%= f.label :quantity, "الكمية", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.number_field :quantity, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
          <div class="md:col-span-2">
            <%= f.label :instructions, "تعليمات", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_area :instructions, rows: 2, placeholder: "بعد الأكل",
                  class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
        </div>
      <% end %>
    </div>

    <%= render "dashboard/visit_wizard/actions" %>
  <% end %>
</div>
