<% content_for :title, "موعد المتابعة — #{@appointment.patient&.display_name}" %>

<div class="max-w-3xl mx-auto p-4">
  <%= render "dashboard/visit_wizard/header" %>

  <%= form_with url: wizard_save_dashboard_appointment_path(@appointment),
                method: :post, class: "space-y-4" do %>
    <%= hidden_field_tag :step, "followup" %>

    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
        <span class="text-xl">📅</span> موعد المتابعة
      </h2>

      <p class="text-sm text-slate-500 mb-4">
        هل يحتاج المريض لمتابعة؟ اختر تاريخاً أو تخطَّ هذه الخطوة.
      </p>

      <div class="max-w-xs">
        <%= label_tag :followup_date, "تاريخ المتابعة",
              class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= date_field_tag :followup_date, @appointment.follow_up_date,
              min: Date.current + 1.day,
              class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500" %>
      </div>

      <!-- Quick pick buttons -->
      <div class="flex flex-wrap gap-2 mt-4">
        <button type="button" onclick="document.getElementById('followup_date').value='<%= Date.current + 1.week %>'"
                class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg font-semibold cursor-pointer">
          بعد أسبوع
        </button>
        <button type="button" onclick="document.getElementById('followup_date').value='<%= Date.current + 2.weeks %>'"
                class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg font-semibold cursor-pointer">
          بعد أسبوعين
        </button>
        <button type="button" onclick="document.getElementById('followup_date').value='<%= Date.current + 1.month %>'"
                class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg font-semibold cursor-pointer">
          بعد شهر
        </button>
        <button type="button" onclick="document.getElementById('followup_date').value='<%= Date.current + 3.months %>'"
                class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg font-semibold cursor-pointer">
          بعد 3 أشهر
        </button>
      </div>
    </div>

    <%= render "dashboard/visit_wizard/actions" %>
  <% end %>
</div>
