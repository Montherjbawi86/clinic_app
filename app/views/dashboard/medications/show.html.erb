<% content_for :title, "#{@medication.display_name} — #{@patient.display_name}" %>

<%
  badge = case @medication.status
          when "active"       then "bg-emerald-50 text-emerald-700 ring-emerald-200"
          when "completed"    then "bg-sky-50 text-sky-700 ring-sky-200"
          when "discontinued" then "bg-rose-50 text-rose-700 ring-rose-200"
          else "bg-slate-100 text-slate-700 ring-slate-200"
          end
  status_label = { "active" => "فعالة", "completed" => "مكتملة", "discontinued" => "موقوفة" }[@medication.status] || @medication.status
%>

<div class="max-w-4xl mx-auto space-y-5">

  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-sm text-slate-500">
    <%= link_to "لوحة التحكم", dashboard_path, class: "hover:text-teal-600" %>
    <span>/</span>
    <%= link_to "الأدوية", dashboard_medications_path, class: "hover:text-teal-600" %>
    <span>/</span>
    <span class="text-slate-700 font-medium"><%= @medication.display_name %></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

    <!-- ===================== LEFT: MAIN INFO ===================== -->
    <div class="lg:col-span-2 space-y-5">

      <!-- Header card -->
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-start justify-between flex-wrap gap-3">
          <div>
            <h1 class="text-2xl font-bold text-slate-800">💊 <%= @medication.display_name %></h1>
            <% if @medication.name_ar.present? && @medication.name.present? %>
              <p class="text-slate-500 mt-1"><%= @medication.name %></p>
            <% end %>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold px-3 py-1.5 rounded-full ring-1 <%= badge %>">
            <span class="w-2 h-2 rounded-full <%= @medication.status == "active" ? "bg-emerald-500" : (@medication.status == "completed" ? "bg-sky-500" : "bg-rose-500") %>"></span>
            <%= status_label %>
          </span>
        </div>

        <!-- Prescription details grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-6 text-sm">
          <div>
            <div class="text-slate-500 text-xs">الجرعة</div>
            <div class="font-bold text-slate-800 text-lg mt-0.5"><%= @medication.dosage %></div>
          </div>
          <div>
            <div class="text-slate-500 text-xs">التكرار</div>
            <div class="font-semibold text-slate-800 mt-0.5"><%= @medication.frequency.presence || "—" %></div>
          </div>
          <div>
            <div class="text-slate-500 text-xs">المدة</div>
            <div class="font-semibold text-slate-800 mt-0.5"><%= @medication.duration.presence || "—" %></div>
          </div>
          <div>
            <div class="text-slate-500 text-xs">طريقة الاستخدام</div>
            <div class="font-semibold text-slate-800 mt-0.5">
              <%= t("medications.routes.#{@medication.route}", default: @medication.route.presence || "—") %>
            </div>
          </div>
          <div>
            <div class="text-slate-500 text-xs">الكمية</div>
            <div class="font-semibold text-slate-800 mt-0.5"><%= @medication.quantity.presence || "—" %></div>
          </div>
          <div>
            <div class="text-slate-500 text-xs">تجديدات متبقية</div>
            <div class="font-semibold text-slate-800 mt-0.5">
              <%= @medication.refills.to_i %>
              <% if @medication.refills.to_i > 0 %>
                <span class="text-xs text-amber-600">🔁</span>
              <% end %>
            </div>
          </div>
        </div>

        <% if @medication.instructions.present? %>
          <div class="mt-5 p-4 rounded-xl bg-amber-50 border border-amber-200">
            <div class="text-xs font-semibold text-amber-800 mb-1">💡 تعليمات</div>
            <div class="text-sm text-amber-800 whitespace-pre-wrap"><%= @medication.instructions %></div>
          </div>
        <% end %>
      </div>

      <!-- Patient + Doctor card -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% if @patient %>
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 mb-3">👤 المريض</div>
            <div class="flex items-center gap-3">
              <% if @patient.photo.attached? %>
                <%= image_tag @patient.photo, class: "w-12 h-12 rounded-xl object-cover" %>
              <% else %>
                <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center text-lg font-bold">
                  <%= @patient.display_name&.first&.upcase || "؟" %>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <%= link_to dashboard_patient_path(@patient),
                      class: "font-semibold text-slate-800 hover:text-teal-600 truncate block" do %>
                  <%= @patient.display_name %>
                <% end %>
                <div class="text-xs text-slate-500"><%= @patient.phone.presence || "—" %></div>
              </div>
            </div>
            <% if @patient.allergies.present? %>
              <div class="mt-3 p-2 rounded-lg bg-rose-50 text-xs text-rose-700">
                ⚠️ حساسية: <%= @patient.allergies.truncate(60) %>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
          <div class="text-xs font-semibold text-slate-500 mb-3">👨‍⚕️ الطبيب</div>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center text-lg font-bold">
              <%= @medication.doctor&.name&.first&.upcase || "؟" %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-slate-800 truncate">د. <%= @medication.doctor&.name || "—" %></div>
              <div class="text-xs text-slate-500">
                <%= @medication.created_at.strftime("%Y-%m-%d %H:%M") %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
        <div class="text-xs font-semibold text-slate-500 mb-3">⚡ إجراءات</div>
        <div class="flex flex-wrap gap-2">
          <% if @medication.appointment.present? %>
            <%= link_to "🖨️ طباعة الوصفة",
                  prescription_dashboard_appointment_path(@medication.appointment, format: :pdf),
                  target: "_blank",
                  class: "inline-flex items-center gap-2 bg-slate-800 text-white px-4 py-2 rounded-lg font-semibold hover:bg-slate-900 text-sm" %>
          <% end %>
          <% if @medication.status == "active" %>
            <% if @medication.refills.to_i > 0 %>
              <%= button_to "🔁 تجديد",
                    refill_dashboard_medication_path(@medication), method: :patch,
                    class: "inline-flex items-center gap-2 bg-amber-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-amber-600 text-sm cursor-pointer" %>
            <% end %>
            <%= button_to "🏁 إكمال",
                  complete_dashboard_medication_path(@medication), method: :patch,
                  class: "inline-flex items-center gap-2 bg-emerald-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-emerald-700 text-sm cursor-pointer" %>
            <%= button_to "⛔ إيقاف",
                  discontinue_dashboard_medication_path(@medication), method: :patch,
                  data: { turbo_confirm: "إيقاف الوصفة؟" },
                  class: "inline-flex items-center gap-2 bg-white border border-rose-300 text-rose-600 px-4 py-2 rounded-lg font-semibold hover:bg-rose-50 text-sm cursor-pointer" %>
          <% end %>
          <%= button_to "🗑️ حذف",
                dashboard_medication_path(@medication), method: :delete,
                data: { turbo_confirm: "حذف الوصفة نهائياً؟" },
                class: "inline-flex items-center gap-2 bg-white border border-slate-300 text-slate-600 px-4 py-2 rounded-lg font-semibold hover:bg-slate-50 text-sm cursor-pointer" %>
        </div>
      </div>

      <!-- Other meds for this patient -->
      <% if @patient %>
        <% other = @patient.medications.where.not(id: @medication.id).order(created_at: :desc).limit(5) %>
        <% if other.any? %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
            <div class="p-5 border-b border-slate-200 flex items-center justify-between">
              <h2 class="font-semibold text-slate-800">💊 أدوية أخرى للمريض</h2>
              <span class="text-xs text-slate-500"><%= other.count %> وصفة</span>
            </div>
            <ul class="divide-y divide-slate-100">
              <% other.each do |m| %>
                <li class="p-4 flex items-center justify-between">
                  <%= link_to dashboard_medication_path(m),
                        class: "flex-1 min-w-0 hover:text-teal-600" do %>
                    <div class="font-medium text-slate-800 truncate"><%= m.display_name %></div>
                    <div class="text-xs text-slate-500">
                      <%= m.dosage %> · <%= m.created_at.strftime("%Y-%m-%d") %>
                    </div>
                  <% end %>
                  <span class="text-xs px-2 py-1 rounded-full
                    <%= m.status == "active" ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600" %>">
                    <%= m.status %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- ===================== RIGHT: QR + SHARE ===================== -->
    <div class="lg:col-span-1 space-y-4">

      <!-- QR Card -->
      <% if @qr_data_uri.present? %>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm text-center sticky top-4">
          <div class="text-xs font-semibold text-slate-500 mb-3">📱 رمز الوصفة</div>

          <div class="bg-white p-3 rounded-xl border-2 border-slate-100 inline-block">
            <img src="<%= @qr_data_uri %>" style="width: 192px; height: 192px; display: block;" alt="QR Code">
          </div>

          <div class="text-xs text-slate-500 mt-3">
            امسح الرمز لفتح الوصفة على الجوال
          </div>

          <div class="flex flex-col gap-2 mt-4">
            <%= link_to "🔗 فتح الصفحة",
                  public_medication_path(@medication.public_token),
                  target: "_blank",
                  class: "w-full bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 text-sm" %>

            <button type="button"
                    onclick="navigator.clipboard.writeText('<%= public_medication_url(@medication.public_token) %>'); this.textContent='✅ تم النسخ'; setTimeout(() => this.textContent='📋 نسخ الرابط', 2000)"
                    class="w-full bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-lg font-semibold hover:bg-slate-50 text-sm cursor-pointer">
              📋 نسخ الرابط
            </button>
          </div>
        </div>
      <% else %>
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-5 text-center text-sm text-slate-500">
          ⚠️ لم يتم إنشاء رمز QR
        </div>
      <% end %>

      <!-- Quick info card -->
      <div class="bg-teal-50 border border-teal-200 rounded-2xl p-5">
        <div class="text-xs font-semibold text-teal-800 mb-2">ℹ️ معلومات</div>
        <div class="space-y-2 text-xs text-teal-700">
          <div class="flex justify-between">
            <span>رقم الوصفة:</span>
            <span class="font-semibold">#<%= @medication.id.to_s.rjust(6, "0") %></span>
          </div>
          <div class="flex justify-between">
            <span>تاريخ الوصف:</span>
            <span class="font-semibold"><%= @medication.created_at.strftime("%Y-%m-%d") %></span>
          </div>
          <div class="flex justify-between">
            <span>آخر تحديث:</span>
            <span class="font-semibold"><%= @medication.updated_at.strftime("%Y-%m-%d") %></span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
