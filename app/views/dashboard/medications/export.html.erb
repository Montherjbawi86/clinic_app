<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8">
  <style>
    @page { size: A4; margin: 12mm; }
    body {
      font-family: "Noto Naskh Arabic", "Geeza Pro", "Amiri", "Arial", sans-serif;
      color: #1e293b;
      font-size: 11px;
      line-height: 1.5;
    }
    .header {
      text-align: center;
      border-bottom: 3px solid #0d9488;
      padding-bottom: 12px;
      margin-bottom: 18px;
    }
    .clinic-name { font-size: 20px; font-weight: bold; color: #0d9488; }
    .clinic-info { font-size: 10px; color: #64748b; margin-top: 4px; }
    .doc-title {
      text-align: center;
      font-size: 16px;
      font-weight: bold;
      color: #0f766e;
      margin: 12px 0 18px;
    }
    .meta {
      font-size: 10px;
      color: #64748b;
      text-align: center;
      margin-bottom: 12px;
    }
    table { width: 100%; border-collapse: collapse; font-size: 10px; }
    thead { background: #0d9488; color: white; }
    th {
      padding: 8px 6px;
      text-align: right;
      font-weight: bold;
      border: 1px solid #0f766e;
    }
    td {
      padding: 6px;
      border: 1px solid #e2e8f0;
      text-align: right;
    }
    tbody tr:nth-child(even) { background: #f8fafc; }
    .badge {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 9999px;
      font-size: 9px;
      font-weight: bold;
    }
    .badge-active       { background: #d1fae5; color: #065f46; }
    .badge-completed    { background: #dbeafe; color: #1e40af; }
    .badge-discontinued { background: #fee2e2; color: #991b1b; }
    .badge-default      { background: #f1f5f9; color: #334155; }
    .footer {
      margin-top: 24px;
      padding-top: 8px;
      border-top: 1px solid #e2e8f0;
      text-align: center;
      font-size: 9px;
      color: #94a3b8;
    }
    .summary {
      display: flex;
      justify-content: space-around;
      background: #f0fdfa;
      padding: 10px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-size: 10px;
    }
    .summary-item { text-align: center; }
    .summary-value { font-size: 16px; font-weight: bold; color: #0f766e; display: block; }
  </style>
</head>
<body>

  <div class="header">
    <div class="clinic-name"><%= current_clinic&.name_ar.presence || current_clinic&.name || "ClinicApp" %></div>
    <div class="clinic-info">
      <%= current_clinic&.address_ar.presence || current_clinic&.address %>
      <% if current_clinic&.phone.present? %> · هاتف: <%= current_clinic.phone %><% end %>
    </div>
  </div>

  <div class="doc-title">تقرير الوصفات الطبية</div>

  <div class="meta">
    إجمالي: <%= @medications.count %> وصفة
    · تاريخ التقرير: <%= Date.current %>
    <% if @filter.present? && @filter != "all" %> · تصفية: <%= @filter %><% end %>
  </div>

  <div class="summary">
    <div class="summary-item">
      <span class="summary-value"><%= @total_count %></span>
      الإجمالي
    </div>
    <div class="summary-item">
      <span class="summary-value"><%= @active_count %></span>
      فعالة
    </div>
    <div class="summary-item">
      <span class="summary-value"><%= @completed_count %></span>
      مكتملة
    </div>
    <div class="summary-item">
      <span class="summary-value"><%= @discontinued_count %></span>
      موقوفة
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width: 30px;">#</th>
        <th>المريض</th>
        <th>الدواء</th>
        <th style="width: 60px;">الجرعة</th>
        <th>التكرار</th>
        <th style="width: 60px;">المدة</th>
        <th style="width: 50px;">الكمية</th>
        <th style="width: 70px;">الحالة</th>
        <th>الطبيب</th>
        <th style="width: 80px;">التاريخ</th>
      </tr>
    </thead>
    <tbody>
      <% @medications.each_with_index do |m, i| %>
        <tr>
          <td><%= i + 1 %></td>
          <td><strong><%= m.patient&.display_name || "—" %></strong></td>
          <td>
            <strong><%= m.display_name %></strong>
            <% if m.name_ar.present? && m.name.present? %>
              <div style="font-size: 9px; color: #94a3b8;"><%= m.name %></div>
            <% end %>
          </td>
          <td><%= m.dosage %></td>
          <td><%= m.frequency.presence || "—" %></td>
          <td><%= m.duration.presence || "—" %></td>
          <td><%= m.quantity.presence || "—" %></td>
          <td>
            <% badge = case m.status
                       when "active"       then "badge-active"
                       when "completed"    then "badge-completed"
                       when "discontinued" then "badge-discontinued"
                       else "badge-default"
                       end %>
            <span class="badge <%= badge %>">
              <%= { "active" => "فعالة", "completed" => "مكتملة", "discontinued" => "موقوفة" }[m.status] || m.status %>
            </span>
          </td>
          <td>د. <%= m.doctor&.name || "—" %></td>
          <td><%= m.created_at.strftime("%Y-%m-%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="footer">
    تم إنشاء التقرير في <%= Time.current.strftime("%Y-%m-%d %H:%M") %> — نظام ClinicApp
  </div>

</body>
</html>
