<div class="space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Medications & Prescriptions</h1>
      <p class="text-slate-500 text-sm">Track patient prescriptions and drug items.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-fit">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Prescribe Medication</h2>
      <%= form_with model: [:dashboard, @medication], local: true do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :patient_id, "Patient", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.collection_select :patient_id, Patient.all, :id, :name, { prompt: "Choose patient..." }, class: "w-full border border-slate-300 rounded-xl p-3 bg-white outline-none" %>
          </div>
          <div>
            <%= f.label :name, "Medication Name", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :name, required: true, placeholder: "e.g., Amoxicillin 500mg", class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.label :dosage, "Dosage", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :dosage, placeholder: "e.g., 1 tablet twice daily", class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.label :instructions, "Special Instructions", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_area :instructions, rows: 2, placeholder: "Take after meals", class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.submit "Add Prescription", class: "w-full bg-blue-600 text-white font-semibold p-3 rounded-xl hover:bg-blue-700 transition cursor-pointer shadow-sm" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-4 border-b border-slate-200 bg-slate-50 font-bold text-slate-700">Active Prescriptions</div>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50/50">
            <th class="p-4">Patient</th>
            <th class="p-4">Medication</th>
            <th class="p-4">Dosage</th>
            <th class="p-4">Instructions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if @medications.any? %>
            <% @medications.each do |med| %>
              <tr class="hover:bg-slate-50">
                <td class="p-4 font-semibold text-slate-800"><%= med.patient&.name || "N/A" %></td>
                <td class="p-4 text-blue-600 font-semibold"><%= med.name %></td>
                <td class="p-4 text-slate-700"><%= med.dosage.presence || "N/A" %></td>
                <td class="p-4 text-slate-500"><%= med.instructions.presence || "None" %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="p-8 text-center text-slate-400">No medications prescribed yet.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
