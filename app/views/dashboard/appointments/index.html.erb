<div class="space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Appointments Schedule</h1>
      <p class="text-slate-500 text-sm">Book and manage upcoming patient visits.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Schedule Form -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-fit">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Book New Appointment</h2>
      <%= form_with model: [:dashboard, @appointment], local: true do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :patient_id, "Select Patient", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.collection_select :patient_id, Patient.all, :id, :name, { prompt: "Choose patient..." }, class: "w-full border border-slate-300 rounded-xl p-3 bg-white outline-none" %>
          </div>
          <div>
            <%= f.label :appointment_date, "Date", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.date_field :appointment_date, class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.label :appointment_time, "Time", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.time_field :appointment_time, class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.label :reason, "Reason for Visit", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :reason, placeholder: "e.g., General checkup", class: "w-full border border-slate-300 rounded-xl p-3 outline-none" %>
          </div>
          <div>
            <%= f.submit "Schedule Appointment", class: "w-full bg-blue-600 text-white font-semibold p-3 rounded-xl hover:bg-blue-700 transition cursor-pointer shadow-sm" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Appointments List -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-4 border-b border-slate-200 bg-slate-50 font-bold text-slate-700">Scheduled Visits</div>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50/50">
            <th class="p-4">Patient</th>
            <th class="p-4">Date & Time</th>
            <th class="p-4">Reason</th>
            <th class="p-4 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if @appointments.any? %>
            <% @appointments.each do |appt| %>
              <tr class="hover:bg-slate-50">
                <td class="p-4 font-semibold text-slate-800"><%= appt.patient&.name || "Unknown Patient" %></td>
                <td class="p-4 text-slate-600"><%= appt.appointment_date %> <%= appt.appointment_time %></td>
                <td class="p-4 text-slate-600"><%= appt.reason.presence || "General checkup" %></td>
                <td class="p-4 text-right">
                  <%= button_to "Cancel", dashboard_appointment_path(appt), method: :delete, class: "text-rose-600 hover:text-rose-800 font-medium text-xs cursor-pointer" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="p-8 text-center text-slate-400">No scheduled appointments.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
