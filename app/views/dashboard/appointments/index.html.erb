<% content_for :title, "#{t('appointments.title')} — ClinicApp" %>

<div class="space-y-6">

  <!-- ============================================================
       HEADER
       ============================================================ -->
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">📅 <%= t("appointments.title") %></h1>
      <p class="text-slate-500 mt-1"><%= t("appointments.subtitle") %></p>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <%= form_with url: dashboard_appointments_path, method: :get, class: "flex gap-2 flex-wrap" do %>
        <%= hidden_field_tag :filter, @filter %>
        <%= date_field_tag :date, params[:date],
              class: "border border-slate-300 rounded-lg px-3 py-2 text-sm" %>
        <%= submit_tag t("actions.filter"),
              class: "bg-slate-800 text-white px-4 py-2 rounded-lg font-semibold cursor-pointer text-sm" %>
        <%= link_to t("actions.today"),
              dashboard_appointments_path(filter: "today"),
              class: "px-3 py-2 rounded-lg bg-slate-100 text-slate-700 font-semibold text-sm hover:bg-slate-200" %>
      <% end %>
      <%= link_to "🗓️ التقويم", dashboard_calendar_path,
            class: "px-3 py-2 rounded-lg bg-teal-600 text-white font-semibold text-sm hover:bg-teal-700" %>
    </div>
  </div>

  <!-- ============================================================
       FILTER TABS
       ============================================================ -->
  <div class="flex flex-wrap gap-2">
    <%
      tabs = [
        ["all",       t("actions.all"),                    @counts[:all]],
        ["today",     t("actions.today"),                  @counts[:today]],
        ["upcoming",  t("appointments.filters.upcoming"),  @counts[:upcoming]],
        ["open",      t("appointments.filters.open"),      @counts[:open]],
        ["completed", t("appointments.filters.completed"), @counts[:completed]],
        ["cancelled", t("appointments.filters.cancelled"), @counts[:cancelled]],
        ["pending_bookings", "🔔 طلبات جديدة", @counts[:pending_bookings]],
      ]
    %>
    <% tabs.each do |key, label, count| %>
      <% active = @filter == key %>
      <%= link_to dashboard_appointments_path(filter: key),
            class: "px-3 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition #{active ? 'bg-teal-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'}" do %>
        <%= label %>
        <span class="text-xs px-1.5 py-0.5 rounded-full <%= active ? 'bg-white/20' : 'bg-slate-100 text-slate-600' %>">
          <%= count %>
        </span>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- ============================================================
         NEW APPOINTMENT FORM
         ============================================================ -->
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm lg:col-span-1 h-fit lg:sticky lg:top-4">
      <h2 class="font-semibold text-slate-800 mb-4">＋ <%= t("appointments.new") %></h2>

      <%= form_with model: [:dashboard, @appointment], class: "space-y-3" do |f| %>
        <% if @appointment.errors.any? %>
          <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 p-3 rounded-r-lg text-sm">
            <%= @appointment.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div>
          <%= f.label :patient_id, t("appointments.patient"), class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.collection_select :patient_id, @patients, :id, :display_name,
                { prompt: t("appointments.select_patient") },
                class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :doctor_id, t("appointments.doctor"), class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.collection_select :doctor_id, @doctors, :id, :name,
                { prompt: t("appointments.select_doctor") },
                class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <%= f.label :appointment_date, t("appointments.date"), class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.date_field :appointment_date, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
          <div>
            <%= f.label :appointment_time, t("appointments.time"), class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.time_field :appointment_time, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
          </div>
        </div>
        <div>
          <%= f.label :duration_minutes, t("appointments.duration"), class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.number_field :duration_minutes, value: 30, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <div>
          <%= f.label :reason, t("appointments.reason"), class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :reason, rows: 2, class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>
        <%= f.submit t("appointments.new"),
              class: "w-full bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 cursor-pointer" %>
      <% end %>
    </div>

    <!-- ============================================================
         APPOINTMENTS LIST (rich, actionable)
         ============================================================ -->
    <div class="lg:col-span-2 space-y-3">
      <% if @appointments.any? %>
        <% @appointments.each do |a| %>
          <%
            badge = case a.status
                    when "scheduled"  then ["bg-teal-50 text-teal-700 ring-teal-200", "📅"]
                    when "confirmed"  then ["bg-indigo-50 text-indigo-700 ring-indigo-200", "✓"]
                    when "checked_in" then ["bg-amber-50 text-amber-700 ring-amber-200", "⏳"]
                    when "in_progress"then ["bg-purple-50 text-purple-700 ring-purple-200", "▶"]
                    when "completed"  then ["bg-emerald-50 text-emerald-700 ring-emerald-200", "✅"]
                    when "cancelled", "no_show" then ["bg-rose-50 text-rose-700 ring-rose-200", "✕"]
                    else ["bg-slate-100 text-slate-700 ring-slate-200", "•"]
                    end
          %>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition overflow-hidden">

            <!-- Header: date + time + status -->
            <div class="p-4 flex items-start justify-between gap-3 border-b border-slate-100">
              <div class="flex items-center gap-3 min-w-0">
                <!-- Date box -->
                <div class="shrink-0 bg-slate-100 rounded-lg px-3 py-2 text-center">
                  <div class="text-[10px] font-semibold text-slate-500 uppercase">
                    <%= a.appointment_date.strftime("%b") %>
                  </div>
                  <div class="text-lg font-bold text-slate-800 leading-none">
                    <%= a.appointment_date.day %>
                  </div>
                </div>

                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <%= link_to dashboard_appointment_path(a),
                          class: "font-bold text-slate-800 hover:text-teal-600 truncate" do %>
                      <%= a.patient&.display_name %>
                    <% end %>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full ring-1 <%= badge[0] %>">
                      <%= badge[1] %> <%= t("appointments.statuses.#{a.status}", default: a.status) %>
                    </span>
                  </div>
                  <div class="text-sm text-slate-500 mt-0.5">
                    🕐 <%= a.appointment_time&.strftime("%H:%M") || "—" %>
                    · د. <%= a.doctor&.name || "—" %>
                  </div>
                  <% if a.reason.present? %>
                    <div class="text-xs text-slate-500 mt-1">📝 <%= a.reason %></div>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Actions bar -->
            <div class="p-3 bg-slate-50 flex items-center justify-between gap-2 flex-wrap">

              <!-- Left: primary action based on status -->
              <div class="flex items-center gap-2 flex-wrap">
                <% if a.status == "scheduled" || a.status == "confirmed" %>
                  <%= button_to check_in_dashboard_appointment_path(a), method: :patch,
                        class: "inline-flex items-center gap-1.5 bg-amber-500 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-amber-600 text-xs" do %>
                    ✓ <%= t("appointments.actions.check_in") %>
                  <% end %>
                <% end %>

                <% if a.status == "checked_in" %>
                  <%= button_to start_visit_dashboard_appointment_path(a), method: :patch,
                        class: "inline-flex items-center gap-1.5 bg-purple-600 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-purple-700 text-xs" do %>
                    ▶ <%= t("appointments.actions.start") %>
                  <% end %>
                <% end %>

                <% if a.status == "in_progress" || a.status == "checked_in" %>
                  <%= link_to "📝 #{t('appointments.actions.complete')}",
                        dashboard_appointment_path(a),
                        class: "inline-flex items-center gap-1.5 bg-emerald-600 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-emerald-700 text-xs" %>
                <% end %>

                <!-- ⭐ THE KEY ACTION: Prescription -->
                <% if a.status.in?(%w[checked_in in_progress completed]) %>
                  <%= link_to "＋ وصفة",
                        dashboard_medications_path(appointment_id: a.id, patient_id: a.patient_id),
                        class: "inline-flex items-center gap-1.5 bg-teal-600 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-teal-700 text-xs shadow-sm" %>
                <% end %>

                <!-- Report -->
                <% if a.status.in?(%w[in_progress completed]) %>
                  <%= link_to "📋 تقرير",
                        dashboard_reports_path(patient_id: a.patient_id, appointment_id: a.id),
                        class: "inline-flex items-center gap-1.5 bg-white border border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg font-semibold hover:bg-slate-50 text-xs" %>
                <% end %>

                <!-- Print prescription -->
                <% if a.medications.any? %>
                  <%= link_to "🖨️ طباعة",
                        prescription_dashboard_appointment_path(a, format: :pdf),
                        target: "_blank",
                        class: "inline-flex items-center gap-1.5 bg-white border border-slate-300 text-slate-700 px-3 py-1.5 rounded-lg font-semibold hover:bg-slate-50 text-xs" %>
                <% end %>
              </div>

              <!-- Right: more actions -->
              <div class="flex items-center gap-1">
                <%= link_to dashboard_appointment_path(a),
                      class: "p-1.5 rounded-lg text-slate-400 hover:text-teal-600 hover:bg-white",
                      title: "عرض التفاصيل" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                <% end %>

                <% if a.open? %>
                  <%= button_to "✕",
                        no_show_dashboard_appointment_path(a), method: :patch,
                        data: { turbo_confirm: "تسجيل عدم الحضور؟" },
                        class: "p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-white text-sm font-bold cursor-pointer",
                        title: "لم يحضر" %>
                <% end %>
              </div>
            </div>

            <!-- Patient context strip (visible when checked in) -->
            <% if a.status.in?(%w[checked_in in_progress]) && a.patient %>
              <div class="px-4 py-2 bg-amber-50/50 border-t border-amber-100 flex items-center justify-between text-xs">
                <div class="flex items-center gap-3">
                  <span class="text-slate-600">
                    👤 <%= a.patient.display_name %>
                  </span>
                  <% if a.patient.phone.present? %>
                    <a href="tel:<%= a.patient.phone %>" class="text-teal-600 hover:underline">
                      📞 <%= a.patient.phone %>
                    </a>
                  <% end %>
                  <% if a.patient.allergies.present? %>
                    <span class="text-rose-600 font-semibold">⚠️ حساسية</span>
                  <% end %>
                </div>
                <%= link_to "ملف المريض ←",
                      dashboard_patient_path(a.patient),
                      class: "text-teal-600 hover:underline font-semibold" %>
              </div>
            <% end %>

          </div>
        <% end %>
      <% else %>
        <div class="bg-white rounded-2xl border-2 border-dashed border-slate-200 p-12 text-center">
          <div class="text-5xl mb-3">📅</div>
          <p class="text-slate-500 text-sm"><%= t("appointments.no_appointments") %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
