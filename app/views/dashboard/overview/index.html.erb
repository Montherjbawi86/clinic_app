<div class="space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Clinic Management Dashboard</h1>
      <p class="text-slate-500 mt-1">Welcome back, Dr. <%= current_user.name %>. Here is your clinic overview.</p>
    </div>
    <div class="flex gap-3">
      <a href="/dashboard/patients/new" class="bg-blue-600 text-white px-4 py-2 rounded-xl font-semibold hover:bg-blue-700 transition shadow-sm flex items-center gap-2">
        <span>+ Add Patient</span>
      </a>
      <a href="/dashboard/appointments" class="bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl font-semibold hover:bg-slate-50 transition shadow-sm">
        Appointments
      </a>
    </div>
  </div>

  <!-- Metric Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <p class="text-sm font-medium text-slate-500 uppercase tracking-wider">Total Patients</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= Patient.count %></p>
      <a href="/dashboard/patients" class="text-xs text-blue-600 font-semibold mt-4 inline-block hover:underline">Manage Patients &rarr;</a>
    </div>
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <p class="text-sm font-medium text-slate-500 uppercase tracking-wider">Appointments</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= Appointment.count %></p>
      <a href="/dashboard/appointments" class="text-xs text-blue-600 font-semibold mt-4 inline-block hover:underline">View Schedule &rarr;</a>
    </div>
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <p class="text-sm font-medium text-slate-500 uppercase tracking-wider">Medical Reports</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= MedicalReport.count rescue 0 %></p>
      <a href="/dashboard/reports" class="text-xs text-blue-600 font-semibold mt-4 inline-block hover:underline">View Reports &rarr;</a>
    </div>
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <p class="text-sm font-medium text-slate-500 uppercase tracking-wider">AI Assistant</p>
      <p class="mt-2 text-3xl font-bold text-emerald-600">Active</p>
      <a href="/dashboard/chat" class="text-xs text-blue-600 font-semibold mt-4 inline-block hover:underline">Open Chat &rarr;</a>
    </div>
  </div>

  <!-- Quick Links Section -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-bold text-slate-900 mb-4">Quick Module Access</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/dashboard/patients" class="p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-blue-50 hover:border-blue-200 transition text-center group">
        <span class="block font-semibold text-slate-800 group-hover:text-blue-600">Patients</span>
        <span class="text-xs text-slate-500">Add & search records</span>
      </a>
      <a href="/dashboard/appointments" class="p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-blue-50 hover:border-blue-200 transition text-center group">
        <span class="block font-semibold text-slate-800 group-hover:text-blue-600">Appointments</span>
        <span class="text-xs text-slate-500">Schedule & calendar</span>
      </a>
      <a href="/dashboard/medications" class="p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-blue-50 hover:border-blue-200 transition text-center group">
        <span class="block font-semibold text-slate-800 group-hover:text-blue-600">Medications</span>
        <span class="text-xs text-slate-500">Prescriptions & items</span>
      </a>
      <a href="/dashboard/payments" class="p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-blue-50 hover:border-blue-200 transition text-center group">
        <span class="block font-semibold text-slate-800 group-hover:text-blue-600">Payments</span>
        <span class="text-xs text-slate-500">Invoices & billing</span>
      </a>
    </div>
  </div>
</div>
