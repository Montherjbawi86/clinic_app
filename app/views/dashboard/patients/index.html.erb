<% content_for :title, "#{t('patients.title')} — ClinicApp" %>

<div class="space-y-6">

  <!-- Header -->
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">👥 <%= t("patients.title") %></h1>
      <p class="text-slate-500 mt-1"><%= t("patients.subtitle") %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to t("patients.print_pdf"),
            dashboard_patients_path(format: :pdf, q: params[:q], filter: @filter, sort: @sort),
            target: "_blank",
            class: "px-4 py-2 rounded-lg bg-slate-800 text-white font-semibold hover:bg-slate-900 text-sm" %>
      <%= link_to t("patients.export_csv"),
            dashboard_patients_path(format: :csv, q: params[:q], filter: @filter),
            class: "px-4 py-2 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold hover:bg-slate-50 text-sm" %>
      <%= link_to "＋ #{t('patients.new')}", new_dashboard_patient_path,
            class: "bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 transition shadow-sm text-sm" %>
    </div>
  </div>

  <!-- Filter tabs -->
  <div class="flex flex-wrap items-center gap-2">
    <%
      filters = [
        ["all",       t("patients.filters.all"),       @total_count],
        ["in_clinic", t("patients.filters.in_clinic"), @in_clinic_count],
        ["today",     t("patients.filters.today"),     @today_count],
        ["pending",   t("patients.filters.pending"),   @pending_count],
        ["recent",    t("patients.filters.recent"),    @new_month],
        ["allergies", t("patients.filters.allergies"), @allergies_count],
        ["chronic",   t("patients.filters.chronic"),   nil],
        ["insurance", t("patients.filters.insurance"), @insurance_count],
      ]
    %>
    <% filters.each do |key, label, count| %>
      <% active = @filter == key %>
      <%= link_to dashboard_patients_path(filter: key, q: params[:q], sort: @sort),
            class: "px-3 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition #{active ? 'bg-teal-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'}" do %>
        <%= label %>
        <% if count && count > 0 %>
          <span class="text-xs px-1.5 py-0.5 rounded-full <%= active ? 'bg-white/20' : 'bg-slate-100 text-slate-600' %>"><%= count %></span>
        <% end %>
      <% end %>
    <% end %>

    <div class="ms-auto flex items-center gap-2">
      <%= form_with url: dashboard_patients_path, method: :get, class: "flex gap-2" do %>
        <%= hidden_field_tag :filter, @filter %>
        <div class="relative">
          <span class="absolute inset-y-0 start-3 flex items-center text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/>
            </svg>
          </span>
          <input type="text" name="q" value="<%= params[:q] %>"
                 placeholder="<%= t('patients.search_placeholder') %>"
                 class="ps-9 pe-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 w-56">
        </div>
        <%= select_tag :sort,
              options_for_select([
                [t("patients.sort.newest"),  "newest"],
                [t("patients.sort.oldest"),  "oldest"],
                [t("patients.sort.name"),    "name"],
                [t("patients.sort.updated"), "updated"]
              ], @sort),
              onchange: "this.form.submit()",
              class: "text-sm border border-slate-300 rounded-lg px-2 py-2" %>
        <%= submit_tag t("actions.search"), class: "bg-slate-800 text-white px-4 py-2 rounded-lg font-semibold text-sm cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <% if @patients.any? %>
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-500">
          <tr>
            <th class="text-start px-5 py-3 font-medium"><%= t("patients.table.patient") %></th>
            <th class="text-start px-5 py-3 font-medium"><%= t("patients.table.phone") %></th>
            <th class="text-start px-5 py-3 font-medium"><%= t("patients.table.age") %></th>
            <th class="text-start px-5 py-3 font-medium"><%= t("patients.table.status") %></th>
            <th class="text-start px-5 py-3 font-medium"><%= t("patients.table.allergies") %></th>
            <th class="text-start px-5 py-3 font-medium"><%= t("patients.table.insurance") %></th>
            <th class="px-5 py-3 text-end"><%= t("patients.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @patients.each do |p| %>
            <%
              today_appts   = @today_appts[p.id] || []
              upcoming_appt = (@upcoming_appts[p.id] || []).first
              recent_med    = (@recent_meds[p.id] || []).first
              pending_amt   = @pending_payments[p.id]

              status = nil

              if today_appts.any? { |a| %w[checked_in in_progress].include?(a.status) }
                status = { icon: "🟢", text: t("patients.status.in_clinic"), color: "emerald" }
              elsif today_appts.any?
                appt = today_appts.first
                status = { icon: "📅", text: t("patients.status.appointment_at", time: appt.appointment_time&.strftime('%H:%M')), color: "teal" }
              elsif upcoming_appt
                status = { icon: "⏰", text: t("patients.status.appointment_on", date: upcoming_appt.appointment_date.strftime('%m/%d')), color: "indigo" }
              elsif pending_amt.present? && pending_amt.positive?
                status = { icon: "⚠️", text: t("patients.status.pending_payment"), color: "rose" }
              elsif recent_med
                days = ((Time.current - recent_med.created_at) / 1.day).round
                if days.zero?
                  status = { icon: "💊", text: t("patients.status.prescription_today"), color: "purple" }
                else
                  status = { icon: "💊", text: t("patients.status.prescription_days_ago", days: days), color: "purple" }
                end
              end
            %>
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-3">
                <div class="flex items-center gap-3">
                  <div class="shrink-0">
                    <% if p.respond_to?(:photo) && p.photo.attached? %>
                      <%= image_tag p.photo, class: "w-9 h-9 rounded-full object-cover" %>
                    <% else %>
                      <div class="w-9 h-9 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center text-xs font-bold">
                        <%= p.display_name.to_s.split.map { |w| w[0] }.join.upcase[0,2] %>
                      </div>
                    <% end %>
                  </div>
                  <div class="min-w-0">
                    <%= link_to p.display_name, dashboard_patient_path(p),
                          class: "font-medium text-slate-800 hover:text-teal-600 truncate block" %>
                    <% if p.name_ar.present? && p.name.present? %>
                      <div class="text-xs text-slate-400 truncate"><%= p.name %></div>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="px-5 py-3 text-slate-600"><%= p.phone.presence || "—" %></td>
              <td class="px-5 py-3 text-slate-600"><%= p.age.presence || p.age_from_dob || "—" %></td>
              <td class="px-5 py-3">
                <% if status %>
                  <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-1 rounded-full bg-<%= status[:color] %>-50 text-<%= status[:color] %>-700 whitespace-nowrap">
                    <%= status[:icon] %> <%= status[:text] %>
                  </span>
                <% else %>
                  <span class="text-xs text-slate-400">—</span>
                <% end %>
              </td>
              <td class="px-5 py-3">
                <% if p.allergies.present? %>
                  <span class="text-xs font-semibold px-2 py-1 rounded-full bg-rose-50 text-rose-700 truncate max-w-[8rem] inline-block">
                    ⚠️ <%= p.allergies.truncate(20) %>
                  </span>
                <% else %>
                  <span class="text-xs text-slate-400">—</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-slate-600 text-xs">
                <%= p.insurance_provider.presence || "—" %>
              </td>
              <td class="px-5 py-3 text-end whitespace-nowrap">
                <%= link_to t("patients.actions.view"), dashboard_patient_path(p),
                      class: "text-xs text-teal-600 hover:underline font-semibold me-2" %>
                <%= link_to t("patients.actions.edit"), edit_dashboard_patient_path(p),
                      class: "text-xs text-slate-600 hover:underline font-semibold me-2" %>
                <%= link_to "📅", dashboard_appointments_path(patient_id: p.id),
                      class: "text-xs hover:opacity-70",
                      title: t("patients.actions.appts") %>
                <%= link_to "💳", dashboard_payments_path(patient_id: p.id),
                      class: "text-xs hover:opacity-70 ms-1",
                      title: t("patients.actions.payment") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-16 text-center">
        <div class="text-6xl mb-4">👥</div>
        <div class="text-lg font-semibold text-slate-700 mb-1">
          <% if params[:q].present? %>
            <%= t("patients.no_results") %>
          <% else %>
            <%= t("patients.empty") %>
          <% end %>
        </div>
        <div class="text-sm text-slate-500 mb-6">
          <% if params[:q].present? %>
            <%= t("patients.try_other") %>
          <% else %>
            <%= t("patients.empty_hint") %>
          <% end %>
        </div>
        <% if params[:q].blank? %>
          <%= link_to t("patients.add_first"), new_dashboard_patient_path,
                class: "bg-teal-600 text-white px-6 py-2.5 rounded-lg font-semibold hover:bg-teal-700 inline-block" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
