<% content_for :title, "#{t('patients.title')} — ClinicApp" %>

<div class="space-y-6">

  <!-- Header -->
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">👥 <%= t("patients.title") %></h1>
      <p class="text-slate-500 mt-1"><%= t("patients.subtitle") %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "📄 طباعة / PDF", dashboard_patients_path(format: :pdf, q: params[:q], filter: @filter, sort: @sort),
            target: "_blank",
            class: "px-4 py-2 rounded-lg bg-slate-800 text-white font-semibold hover:bg-slate-900 text-sm" %>
      <%= link_to "📥 CSV", dashboard_patients_path(format: :csv, q: params[:q], filter: @filter),
            class: "px-4 py-2 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold hover:bg-slate-50 text-sm" %>
      <%= link_to "＋ #{t('patients.new')}", new_dashboard_patient_path,
            class: "bg-teal-600 text-white px-4 py-2 rounded-lg font-semibold hover:bg-teal-700 transition shadow-sm text-sm" %>
    </div>
  </div>

  <!-- Stats (clickable filters) -->
  <%
    stats = [
      ["all",       "👥 الإجمالي",       @total_count,      "text-slate-800",   "bg-slate-100"],
      ["recent",    "✨ هذا الشهر",      @new_month,        "text-emerald-600", "bg-emerald-50"],
      ["allergies", "⚠️ لديهم حساسية",   @allergies_count,  "text-rose-600",    "bg-rose-50"],
      ["insurance", "🛡️ لديهم تأمين",    @insurance_count,  "text-teal-600",    "bg-teal-50"],
    ]
  %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <% stats.each do |key, label, count, text_class, bg_class| %>
      <%
        active = (@filter == key) || (@filter.blank? && key == "all")
        card_class =
          if active
            "border-2 border-teal-500 shadow-md ring-2 ring-teal-100 #{bg_class}"
          else
            "bg-white border border-slate-200 hover:shadow-md hover:border-slate-300"
          end
      %>
      <%= link_to dashboard_patients_path(filter: key, q: params[:q], sort: @sort),
            class: "rounded-2xl p-4 shadow-sm transition block #{card_class}" do %>
        <div class="flex items-center justify-between">
          <div class="text-xs text-slate-500"><%= label %></div>
          <% if active %>
            <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
          <% end %>
        </div>
        <div class="text-2xl font-bold <%= text_class %> mt-1"><%= count %></div>
      <% end %>
    <% end %>
  </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">✨ هذا الشهر</div>
      <div class="text-2xl font-bold text-emerald-600 mt-1"><%= @new_month %></div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">⚠️ لديهم حساسية</div>
      <div class="text-2xl font-bold text-rose-600 mt-1"><%= @allergies_count %></div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">🛡️ لديهم تأمين</div>
      <div class="text-2xl font-bold text-teal-600 mt-1"><%= @insurance_count %></div>
    </div>
  </div>

  <!-- Filters + search -->
  <div class="flex flex-wrap items-center gap-2">
    <%
      filters = [
        ["all",       "الكل",        @total_count],
        ["recent",    "حديثون",      nil],
        ["allergies", "حساسية",      @allergies_count],
        ["chronic",   "أمراض مزمنة", nil],
        ["insurance", "تأمين",       @insurance_count],
      ]
    %>
    <% filters.each do |key, label, count| %>
      <% active = @filter == key %>
      <%= link_to dashboard_patients_path(filter: key, q: params[:q], sort: @sort),
            class: "px-3 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition #{active ? 'bg-teal-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-50'}" do %>
        <%= label %>
        <% if count %>
          <span class="text-xs px-1.5 py-0.5 rounded-full <%= active ? 'bg-white/20' : 'bg-slate-100 text-slate-600' %>"><%= count %></span>
        <% end %>
      <% end %>
    <% end %>

    <div class="ms-auto flex items-center gap-2">
      <%= form_with url: dashboard_patients_path, method: :get, class: "flex gap-2" do %>
        <%= hidden_field_tag :filter, @filter %>
        <div class="relative">
          <span class="absolute inset-y-0 start-3 flex items-center text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/>
            </svg>
          </span>
          <input type="text" name="q" value="<%= params[:q] %>" placeholder="ابحث بالاسم أو الهاتف…"
                 class="ps-9 pe-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 w-56">
        </div>
        <%= select_tag :sort,
              options_for_select([
                ["الأحدث", "newest"],
                ["الأقدم", "oldest"],
                ["الاسم",  "name"],
                ["آخر تحديث", "updated"]
              ], @sort),
              onchange: "this.form.submit()",
              class: "text-sm border border-slate-300 rounded-lg px-2 py-2" %>
        <%= submit_tag "بحث", class: "bg-slate-800 text-white px-4 py-2 rounded-lg font-semibold text-sm cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <% if @patients.any? %>
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-500">
          <tr>
            <th class="text-start px-5 py-3 font-medium">المريض</th>
            <th class="text-start px-5 py-3 font-medium">الهاتف</th>
            <th class="text-start px-5 py-3 font-medium">العمر</th>
            <th class="text-start px-5 py-3 font-medium">الحساسية</th>
            <th class="text-start px-5 py-3 font-medium">التأمين</th>
            <th class="px-5 py-3 text-end">إجراءات</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @patients.each do |p| %>
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-3">
                <div class="flex items-center gap-3">
                  <div class="shrink-0">
                    <% if p.respond_to?(:photo) && p.photo.attached? %>
                      <%= image_tag p.photo, class: "w-9 h-9 rounded-full object-cover" %>
                    <% else %>
                      <div class="w-9 h-9 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center text-xs font-bold">
                        <%= p.display_name.to_s.split.map { |w| w[0] }.join.upcase[0,2] %>
                      </div>
                    <% end %>
                  </div>
                  <div class="min-w-0">
                    <%= link_to p.display_name, dashboard_patient_path(p),
                          class: "font-medium text-slate-800 hover:text-teal-600 truncate block" %>
                    <% if p.name_ar.present? && p.name.present? %>
                      <div class="text-xs text-slate-400 truncate"><%= p.name %></div>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="px-5 py-3 text-slate-600"><%= p.phone.presence || "—" %></td>
              <td class="px-5 py-3 text-slate-600"><%= p.age.presence || p.age_from_dob || "—" %></td>
              <td class="px-5 py-3">
                <% if p.allergies.present? %>
                  <span class="text-xs font-semibold px-2 py-1 rounded-full bg-rose-50 text-rose-700 truncate max-w-[8rem] inline-block">
                    ⚠️ <%= p.allergies.truncate(20) %>
                  </span>
                <% else %>
                  <span class="text-xs text-slate-400">—</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-slate-600 text-xs">
                <%= p.insurance_provider.presence || "—" %>
              </td>
              <td class="px-5 py-3 text-end whitespace-nowrap">
                <%= link_to "عرض", dashboard_patient_path(p),
                      class: "text-xs text-teal-600 hover:underline font-semibold me-2" %>
                <%= link_to "تعديل", edit_dashboard_patient_path(p),
                      class: "text-xs text-slate-600 hover:underline font-semibold me-2" %>
                <%= link_to "📅", dashboard_appointments_path(patient_id: p.id),
                      class: "text-xs hover:opacity-70",
                      title: "المواعيد" %>
                <%= link_to "💳", dashboard_payments_path(patient_id: p.id),
                      class: "text-xs hover:opacity-70 ms-1",
                      title: "دفعة" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-16 text-center">
        <div class="text-6xl mb-4">👥</div>
        <div class="text-lg font-semibold text-slate-700 mb-1">
          <% if params[:q].present? %>
            لا توجد نتائج مطابقة
          <% else %>
            لا يوجد مرضى بعد
          <% end %>
        </div>
        <div class="text-sm text-slate-500 mb-6">
          <% if params[:q].present? %>
            جرّب كلمة بحث أخرى
          <% else %>
            ابدأ بإضافة أول مريض لعيادتك
          <% end %>
        </div>
        <% if params[:q].blank? %>
          <%= link_to "＋ إضافة أول مريض", new_dashboard_patient_path,
                class: "bg-teal-600 text-white px-6 py-2.5 rounded-lg font-semibold hover:bg-teal-700 inline-block" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
