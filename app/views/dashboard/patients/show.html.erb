<% content_for :title, "#{@patient.display_name} — ClinicApp" %>

<div class="space-y-6">
  <%= link_to "← #{t('patients.title')}", dashboard_patients_path, class: "text-sm text-teal-600 hover:underline" %>

  <!-- ============================================================
       HEADER
       ============================================================ -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
    <div class="flex flex-col md:flex-row items-start gap-5">

      <!-- Avatar -->
      <div class="shrink-0">
        <% if @patient.respond_to?(:photo) && @patient.photo.attached? %>
          <%= image_tag @patient.photo, class: "w-24 h-24 rounded-2xl object-cover ring-2 ring-teal-100 shadow-sm" %>
        <% else %>
          <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-teal-500 to-teal-700 text-white flex items-center justify-center text-3xl font-bold shadow-sm">
            <%= @patient.display_name&.split&.map { |w| w[0] }&.join&.upcase&.[](0,2) || "؟" %>
          </div>
        <% end %>
      </div>

      <!-- Info -->
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h1 class="text-2xl font-bold text-slate-800"><%= @patient.display_name %></h1>
            <% if @patient.name_ar.present? && @patient.name.present? %>
              <p class="text-slate-500 mt-1"><%= @patient.name %></p>
            <% end %>

            <!-- Pills -->
            <div class="flex flex-wrap gap-2 mt-2">
              <% if @patient.gender.present? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-teal-100 text-teal-700">
                  <%= @patient.gender == "male" ? "♂ ذكر" : "♀ أنثى" %>
                </span>
              <% end %>
              <% if (@patient.age.presence || @patient.age_from_dob).present? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-slate-100 text-slate-700">
                  🎂 <%= @patient.age.presence || @patient.age_from_dob %> سنة
                </span>
              <% end %>
              <% if @patient.blood_type.present? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-rose-100 text-rose-700">
                  🩸 <%= @patient.blood_type %>
                </span>
              <% end %>
              <% if @patient.allergies.present? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-amber-100 text-amber-800">
                  ⚠️ حساسية
                </span>
              <% end %>
              <% if @patient.chronic_conditions.present? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-amber-100 text-amber-800">
                  💊 مزمن
                </span>
              <% end %>
              <% if @patient.insurance_provider.present? %>
                <span class="text-xs font-semibold px-2 py-1 rounded-full bg-sky-100 text-sky-700">
                  🛡️ <%= @patient.insurance_provider %>
                </span>
              <% end %>
            </div>
          </div>

          <!-- Action buttons -->
          <div class="flex gap-2 flex-wrap">
            <%= link_to "📅 حجز موعد", dashboard_appointments_path(patient_id: @patient.id),
                  class: "px-3 py-2 rounded-lg bg-teal-600 text-white font-semibold hover:bg-teal-700 text-sm" %>
            <%= link_to "💳 دفعة", dashboard_payments_path(patient_id: @patient.id),
                  class: "px-3 py-2 rounded-lg bg-white border border-slate-300 text-slate-700 font-semibold hover:bg-slate-50 text-sm" %>
            <%= link_to "📷 الصور", dashboard_patient_medical_images_path(@patient),
                  class: "px-3 py-2 rounded-lg bg-teal-50 text-teal-700 font-semibold hover:bg-teal-100 text-sm" %>
            <%= link_to "📜 الخط الزمني", timeline_dashboard_patient_path(@patient),
                  class: "px-3 py-2 rounded-lg bg-slate-100 text-slate-700 font-semibold hover:bg-slate-200 text-sm" %>
            <%= link_to "📱 QR", qr_dashboard_patient_path(@patient),
                  class: "px-3 py-2 rounded-lg bg-slate-100 text-slate-700 font-semibold hover:bg-slate-200 text-sm" %>
            <%= link_to "✏️ تعديل", edit_dashboard_patient_path(@patient),
                  class: "px-3 py-2 rounded-lg bg-slate-800 text-white font-semibold hover:bg-slate-900 text-sm" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       QUICK STATS
       ============================================================ -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">📅 الزيارات المكتملة</div>
      <div class="text-2xl font-bold text-slate-800 mt-1"><%= @visits_count %></div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">💰 إجمالي المدفوع</div>
      <div class="text-lg font-bold text-emerald-600 mt-1"><%= number_to_currency(@total_paid, unit: "SYP ", precision: 0) %></div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">⏳ الرصيد المستحق</div>
      <div class="text-lg font-bold <%= @balance_due > 0 ? "text-rose-600" : "text-slate-400" %> mt-1">
        <%= number_to_currency(@balance_due, unit: "SYP ", precision: 0) %>
      </div>
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
      <div class="text-xs text-slate-500">📋 التقارير</div>
      <div class="text-2xl font-bold text-slate-800 mt-1"><%= @reports_count %></div>
    </div>
  </div>

  <!-- ============================================================
       NEXT + LAST APPOINTMENT
       ============================================================ -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Next appointment -->
    <div class="rounded-2xl border <%= @next_appointment ? 'border-teal-200 bg-teal-50' : 'border-slate-200 bg-white' %> p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <div class="text-sm font-semibold text-slate-700">📅 الموعد القادم</div>
        <% if @next_appointment %>
          <span class="text-xs font-bold text-teal-700 bg-white px-2 py-1 rounded-full">
            <%= ((@next_appointment.appointment_date - Date.current).to_i) %> يوم
          </span>
        <% end %>
      </div>
      <% if @next_appointment %>
        <div class="mt-3">
          <div class="font-semibold text-slate-800"><%= @next_appointment.appointment_date %></div>
          <div class="text-sm text-slate-600"><%= @next_appointment.appointment_time %></div>
          <div class="text-xs text-slate-500 mt-1">
            د. <%= @next_appointment.doctor&.name || "—" %>
            <% if @next_appointment.reason.present? %> · <%= @next_appointment.reason %><% end %>
          </div>
        </div>
      <% else %>
        <div class="mt-3 text-sm text-slate-500">لا يوجد موعد قادم</div>
        <%= link_to "احجز موعداً", dashboard_appointments_path(patient_id: @patient.id),
              class: "text-xs text-teal-600 hover:underline font-semibold" %>
      <% end %>
    </div>

    <!-- Last appointment -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <div class="text-sm font-semibold text-slate-700">🕐 آخر زيارة</div>
        <% if @last_appointment %>
          <span class="text-xs text-slate-500 bg-slate-100 px-2 py-1 rounded-full">
            <%= time_ago_in_words(@last_appointment.created_at) %> مضت
          </span>
        <% end %>
      </div>
      <% if @last_appointment %>
        <div class="mt-3">
          <div class="font-semibold text-slate-800"><%= @last_appointment.appointment_date %></div>
          <div class="text-xs text-slate-500 mt-1">
            د. <%= @last_appointment.doctor&.name || "—" %>
            <% if @last_appointment.reason.present? %> · <%= @last_appointment.reason %><% end %>
          </div>
        </div>
      <% else %>
        <div class="mt-3 text-sm text-slate-500">لا توجد زيارات سابقة</div>
      <% end %>
    </div>
  </div>

  <!-- ============================================================
       MEDICAL INFO CARD
       ============================================================ -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
    <h2 class="font-semibold text-slate-800 mb-4">🩺 المعلومات الطبية</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div><div class="text-slate-500">الهاتف</div><div class="font-medium"><%= @patient.phone.presence || "—" %></div></div>
      <div><div class="text-slate-500">الرقم الوطني</div><div class="font-medium"><%= @patient.national_id.presence || "—" %></div></div>
      <div><div class="text-slate-500">تاريخ الميلاد</div><div class="font-medium"><%= @patient.date_of_birth&.strftime("%Y-%m-%d") || "—" %></div></div>
      <div><div class="text-slate-500">فصيلة الدم</div><div class="font-medium"><%= @patient.blood_type.presence || "—" %></div></div>
      <div><div class="text-slate-500">رقم التأمين</div><div class="font-medium"><%= @patient.insurance_number.presence || "—" %></div></div>
      <div><div class="text-slate-500">جهة الطوارئ</div><div class="font-medium"><%= @patient.emergency_name.presence || "—" %></div></div>
      <div><div class="text-slate-500">هاتف الطوارئ</div><div class="font-medium"><%= @patient.emergency_phone.presence || "—" %></div></div>
      <div><div class="text-slate-500">العنوان</div><div class="font-medium truncate"><%= @patient.address.presence || "—" %></div></div>
    </div>

    <% if @patient.allergies.present? %>
      <div class="mt-5 p-4 rounded-xl bg-rose-50 border border-rose-200">
        <div class="text-sm font-semibold text-rose-800">⚠️ الحساسية</div>
        <div class="text-sm text-rose-700 mt-1"><%= @patient.allergies %></div>
      </div>
    <% end %>
    <% if @patient.chronic_conditions.present? %>
      <div class="mt-3 p-4 rounded-xl bg-amber-50 border border-amber-200">
        <div class="text-sm font-semibold text-amber-800">💊 الأمراض المزمنة</div>
        <div class="text-sm text-amber-700 mt-1"><%= @patient.chronic_conditions %></div>
      </div>
    <% end %>
    <% if @patient.medical_history.present? %>
      <div class="mt-3 p-4 rounded-xl bg-slate-50 border border-slate-200">
        <div class="text-sm font-semibold text-slate-700">📋 التاريخ الطبي</div>
        <div class="text-sm text-slate-600 mt-1 whitespace-pre-wrap"><%= @patient.medical_history %></div>
      </div>
    <% end %>
  </div>

  <!-- ============================================================
       MEDICAL IMAGES (if any)
       ============================================================ -->
  <% if @medical_images.any? %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
      <div class="p-5 border-b border-slate-200 flex items-center justify-between">
        <h2 class="font-semibold text-slate-800">📷 الصور الطبية <span class="text-xs text-slate-400">(<%= @images_count %>)</span></h2>
        <%= link_to "عرض الكل", dashboard_patient_medical_images_path(@patient),
              class: "text-sm text-teal-600 hover:underline" %>
      </div>
      <div class="p-5">
        <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
          <% @medical_images.first(6).each do |img| %>
            <%= link_to url_for(img.file), target: "_blank", class: "block" do %>
              <div class="aspect-square rounded-xl overflow-hidden bg-slate-100 ring-1 ring-slate-200 hover:ring-teal-400 transition">
                <% if img.image? %>
                  <%= image_tag img.file, class: "w-full h-full object-cover" %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center text-2xl text-slate-400">📄</div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- ============================================================
       HISTORY SECTIONS
       ============================================================ -->
  <!-- ============================================================
       VISIT HISTORY
       ============================================================ -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
    <div class="p-5 border-b border-slate-200 flex items-center justify-between">
      <h2 class="font-semibold text-slate-800">📅 سجل الزيارات</h2>
      <span class="text-xs text-slate-500">
        <%= @visits.count %> زيارة
      </span>
    </div>

    <% if @visits.any? %>
      <ul class="divide-y divide-slate-100">
        <% @visits.each do |v| %>
          <li class="p-5 hover:bg-slate-50/50 transition">
            <!-- Header: date + doctor + status -->
            <div class="flex items-start justify-between flex-wrap gap-2 mb-3">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center text-lg shrink-0">
                  📅
                </div>
                <div>
                  <div class="font-bold text-slate-800">
                    <%= v.appointment_date %>
                    <% if v.appointment_time.present? %>
                      · <%= format_time(v.appointment_time) %>
                    <% end %>
                  </div>
                  <div class="text-xs text-slate-500">
                    د. <%= v.doctor&.name || "—" %>
                    <% if v.reason.present? %> · <%= v.reason %><% end %>
                  </div>
                </div>
              </div>

              <%
                badge = case v.status
                        when "completed"   then "bg-emerald-50 text-emerald-700"
                        when "checked_in"  then "bg-amber-50 text-amber-700"
                        when "in_progress" then "bg-purple-50 text-purple-700"
                        when "cancelled", "no_show" then "bg-rose-50 text-rose-700"
                        else "bg-teal-50 text-teal-700"
                        end
              %>
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= badge %>">
                <%= t("appointments.statuses.#{v.status}", default: v.status) %>
              </span>
            </div>

            <!-- Body: reports, medications, payment -->
            <div class="space-y-3">

              <!-- Medical report -->
              <% if v.medical_report.present? %>
                <div class="bg-emerald-50/50 border border-emerald-100 rounded-lg p-3">
                  <div class="text-xs font-semibold text-emerald-800 mb-1">📋 التقرير الطبي</div>
                  <div class="text-sm text-slate-700"><%= v.medical_report.display_diagnosis.to_s.truncate(120) %></div>
                  <% if v.medical_report.display_treatment.present? %>
                    <div class="text-xs text-slate-600 mt-1">
                      <span class="font-semibold">العلاج:</span>
                      <%= v.medical_report.display_treatment.to_s.truncate(100) %>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <!-- Medications -->
              <% if v.medications.any? %>
                <div class="bg-purple-50/50 border border-purple-100 rounded-lg p-3">
                  <div class="text-xs font-semibold text-purple-800 mb-2">
                    💊 الأدوية ( <%= v.medications.count %> )
                  </div>
                  <ul class="space-y-3">
                    <% v.medications.each do |m| %>
                      <li class="flex items-start gap-3">
                        <% if m.public_token.present? %>
                          <a href="<%= public_medication_path(m.public_token) %>"
                             target="_blank"
                             title="امسح لعرض الوصفة"
                             class="shrink-0 bg-white border border-purple-200 rounded-lg p-1 hover:border-purple-400 transition">
                            <%
                              require "rqrcode"
                              qr_url = public_medication_url(m.public_token)
                              qr_obj = RQRCode::QRCode.new(qr_url)
                              qr_svg = qr_obj.as_svg(
                                offset: 0,
                                color: "0f172a",
                                shape_rendering: "crispEdges",
                                module_size: 3,
                                standalone: true,
                                use_path: true
                              )
                            %>
                            <div class="w-16 h-16 flex items-center justify-center">
                              <%= qr_svg.html_safe %>
                            </div>
                          </a>
                        <% else %>
                          <div class="w-16 h-16 shrink-0 bg-slate-100 border border-slate-200 rounded-lg flex items-center justify-center text-slate-400 text-[10px] text-center">
                            لا QR
                          </div>
                        <% end %>

                        <div class="flex-1 min-w-0">
                          <%= link_to dashboard_medication_path(m),
                                class: "block hover:text-purple-700" do %>
                            <div class="font-semibold text-slate-800 truncate"><%= m.display_name %></div>
                            <div class="text-xs text-slate-500 truncate">
                              <%= m.dosage %>
                              <% if m.frequency.present? %> · <%= m.frequency %><% end %>
                              <% if m.duration.present? %> · <%= m.duration %><% end %>
                            </div>
                          <% end %>
                          <div class="flex items-center gap-2 mt-1.5 text-[10px]">
                            <span class="font-semibold px-1.5 py-0.5 rounded-full
                              <%= m.status == "active" ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-600" %>">
                              <%= m.status %>
                            </span>
                            <% if m.public_token.present? %>
                              <a href="<%= public_medication_path(m.public_token) %>" target="_blank"
                                 class="text-purple-600 hover:text-purple-800 font-semibold">📱 عرض</a>
                              <button type="button"
                                      onclick="navigator.clipboard.writeText('<%= public_medication_url(m.public_token) %>'); this.textContent='✅'; setTimeout(() => this.textContent='📋', 1500)"
                                      class="text-slate-500 hover:text-slate-700 font-semibold cursor-pointer bg-transparent border-0 p-0">📋</button>
                            <% end %>
                          </div>
                        </div>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <!-- Payment -->
              <% if v.payment.present? %>
                <div class="flex items-center justify-between text-sm bg-amber-50/50 border border-amber-100 rounded-lg p-3">
                  <div class="flex items-center gap-2">
                    <span class="text-amber-600">💳</span>
                    <span class="text-slate-700">دفعة</span>
                  </div>
                  <span class="font-bold text-slate-800"><%= v.payment.display_amount %></span>
                </div>
              <% end %>

              <!-- If nothing attached yet -->
              <% if v.medical_report.blank? && v.medications.empty? && v.payment.blank? %>
                <div class="text-xs text-slate-400 italic">
                  لا توجد تفاصيل مسجلة لهذه الزيارة
                </div>
              <% end %>
            </div>

            <!-- Footer: actions -->
            <div class="flex items-center justify-end gap-2 mt-3 pt-3 border-t border-slate-100">
              <%= link_to "عرض الموعد ←",
                    dashboard_appointment_path(v),
                    class: "text-xs font-semibold text-teal-600 hover:text-teal-800" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="p-12 text-center">
        <div class="text-5xl mb-3">📭</div>
        <div class="text-slate-500 text-sm">لا توجد زيارات مسجلة</div>
        <%= link_to "احجز أول موعد",
              new_dashboard_appointment_path(patient_id: @patient.id),
              class: "inline-block mt-4 text-teal-600 hover:underline font-semibold text-sm" %>
      </div>
    <% end %>
  </div>

  <!-- ============================================================
       LOOSE ITEMS (not linked to a visit)
       ============================================================ -->
  <% if @loose_medications.any? || @loose_reports.any? || @loose_payments.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <% if @loose_medications.any? %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
          <div class="p-5 border-b border-slate-200 flex items-center justify-between">
            <h2 class="font-semibold text-slate-800">💊 أدوية بدون موعد</h2>
            <span class="text-xs text-slate-500"><%= @loose_medications.count %></span>
          </div>
          <ul class="divide-y divide-slate-100">
            <% @loose_medications.each do |m| %>
              <li class="p-4 flex items-center justify-between">
                <%= link_to dashboard_medication_path(m),
                      class: "flex-1 min-w-0 hover:text-teal-600" do %>
                  <div class="font-medium text-slate-800 truncate"><%= m.display_name %></div>
                  <div class="text-xs text-slate-500"><%= m.dosage %> · <%= m.created_at.strftime("%Y-%m-%d") %></div>
                <% end %>
                <span class="text-xs px-2 py-1 rounded-full
                  <%= m.status == "active" ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600" %>">
                  <%= m.status %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @loose_reports.any? %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
          <div class="p-5 border-b border-slate-200 flex items-center justify-between">
            <h2 class="font-semibold text-slate-800">📋 تقارير بدون موعد</h2>
            <span class="text-xs text-slate-500"><%= @loose_reports.count %></span>
          </div>
          <ul class="divide-y divide-slate-100">
            <% @loose_reports.each do |r| %>
              <li class="p-4">
                <div class="text-sm font-medium"><%= r.display_diagnosis.to_s.truncate(80) %></div>
                <div class="text-xs text-slate-500 mt-1">
                  <%= r.created_at.strftime("%Y-%m-%d") %> — د. <%= r.doctor&.name %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
