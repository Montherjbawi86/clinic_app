<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8">
  <style>
    @page { size: A4 landscape; margin: 12mm; }
    body {
      font-family: "Noto Naskh Arabic", "Geeza Pro", "Amiri", "Arial", sans-serif;
      color: #1e293b;
      font-size: 11px;
      line-height: 1.5;
    }
    .header {
      text-align: center;
      border-bottom: 3px solid #0d9488;
      padding-bottom: 12px;
      margin-bottom: 18px;
    }
    .clinic-name { font-size: 20px; font-weight: bold; color: #0d9488; }
    .clinic-info { font-size: 10px; color: #64748b; margin-top: 4px; }
    .doc-title {
      text-align: center;
      font-size: 16px;
      font-weight: bold;
      color: #0f766e;
      margin: 12px 0 18px;
    }
    .meta {
      font-size: 10px;
      color: #64748b;
      text-align: center;
      margin-bottom: 12px;
    }
    table { width: 100%; border-collapse: collapse; font-size: 10px; }
    thead { background: #0d9488; color: white; }
    th {
      padding: 8px 6px;
      text-align: right;
      font-weight: bold;
      border: 1px solid #0f766e;
    }
    td {
      padding: 6px;
      border: 1px solid #e2e8f0;
      text-align: right;
    }
    tbody tr:nth-child(even) { background: #f8fafc; }
    .footer {
      margin-top: 24px;
      padding-top: 8px;
      border-top: 1px solid #e2e8f0;
      text-align: center;
      font-size: 9px;
      color: #94a3b8;
    }
    .summary {
      display: flex;
      justify-content: space-around;
      background: #f0fdfa;
      padding: 10px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-size: 10px;
    }
    .summary-item { text-align: center; }
    .summary-value { font-size: 16px; font-weight: bold; color: #0f766e; display: block; }
  </style>
</head>
<body>

  <div class="header">
    <div class="clinic-name"><%= current_clinic&.name_ar.presence || current_clinic&.name || "ClinicApp" %></div>
    <div class="clinic-info">
      <%= current_clinic&.address_ar.presence || current_clinic&.address %>
      <% if current_clinic&.phone.present? %> · هاتف: <%= current_clinic.phone %><% end %>
    </div>
  </div>

  <div class="doc-title">قائمة المرضى</div>

  <div class="meta">
    إجمالي: <%= @patients.count %> مريض · تاريخ التقرير: <%= Date.current %>
  </div>

  <div class="summary">
    <div class="summary-item"><span class="summary-value"><%= @total_count %></span>إجمالي المرضى</div>
    <div class="summary-item"><span class="summary-value"><%= @new_month %></span>هذا الشهر</div>
    <div class="summary-item"><span class="summary-value"><%= @allergies_count %></span>حساسية</div>
    <div class="summary-item"><span class="summary-value"><%= @insurance_count %></span>تأمين</div>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width: 30px;">#</th>
        <th>الاسم</th>
        <th>الهاتف</th>
        <th style="width: 50px;">العمر</th>
        <th style="width: 50px;">الجنس</th>
        <th style="width: 60px;">فصيلة الدم</th>
        <th>الحساسية</th>
        <th>الأمراض المزمنة</th>
        <th>التأمين</th>
        <th style="width: 80px;">التسجيل</th>
      </tr>
    </thead>
    <tbody>
      <% @patients.each_with_index do |p, i| %>
        <tr>
          <td><%= i + 1 %></td>
          <td><strong><%= p.display_name %></strong></td>
          <td><%= p.phone.presence || "—" %></td>
          <td><%= p.age.presence || p.age_from_dob || "—" %></td>
          <td><%= p.gender == "male" ? "ذكر" : (p.gender == "female" ? "أنثى" : "—") %></td>
          <td><%= p.blood_type.presence || "—" %></td>
          <td><%= p.allergies.presence || "—" %></td>
          <td><%= p.chronic_conditions.presence || "—" %></td>
          <td><%= p.insurance_provider.presence || "—" %></td>
          <td><%= p.created_at.strftime("%Y-%m-%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="footer">
    تم إنشاء التقرير في <%= Time.current.strftime("%Y-%m-%d %H:%M") %> — نظام ClinicApp
  </div>

</body>
</html>
