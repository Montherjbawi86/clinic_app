<% content_for :title, "احجز موعداً — #{@clinic.display_name}" %>

<div class="max-w-lg mx-auto p-4">

  <!-- Back link -->
  <div class="mb-6">
    <%= link_to public_clinic_path(@clinic.slug),
          class: "inline-flex items-center gap-2 text-sm text-teal-600 hover:text-teal-800 font-semibold no-underline" do %>
      ← العودة لصفحة العيادة
    <% end %>
  </div>

  <!-- Clinic header -->
  <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm mb-6 text-center">
    <div class="w-14 h-14 mx-auto rounded-2xl text-white flex items-center justify-center text-2xl mb-3"
         style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
      🏥
    </div>
    <h1 class="text-lg font-bold text-slate-800"><%= @clinic.display_name %></h1>
    <% if @clinic.phone.present? %>
      <a href="tel:<%= @clinic.phone %>" class="text-sm text-teal-600 hover:underline font-semibold">
        📞 <%= @clinic.phone %>
      </a>
    <% end %>
  </div>

  <!-- Booking form -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">

    <div class="text-center mb-6">
      <div class="inline-block bg-teal-50 text-teal-700 px-4 py-1 rounded-full text-sm font-bold mb-3">
        📅 احجز موعدك
      </div>
      <p class="text-sm text-slate-500">
        أدخل بياناتك وسنتواصل معك لتأكيد الموعد
      </p>
    </div>

    <%= form_with url: public_bookings_path(@clinic.slug), method: :post do |f| %>

      <div class="space-y-4">

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            الاسم الكامل <span class="text-rose-500">*</span>
          </label>
          <input type="text" name="name" value="<%= @booking[:name] %>" required
                 placeholder="مثال: أحمد محمد"
                 class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            رقم الهاتف <span class="text-rose-500">*</span>
          </label>
          <input type="tel" name="phone" value="<%= @booking[:phone] %>" required
                 placeholder="0999123456"
                 dir="ltr"
                 class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-end">
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            البريد الإلكتروني (اختياري)
          </label>
          <input type="email" name="email" value="<%= @booking[:email] %>"
                 placeholder="you@example.com"
                 dir="ltr"
                 class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-end">
          <p class="text-xs text-slate-400 mt-1">
            📧 سنرسل لك رابط متابعة الحجز على بريدك
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">التاريخ المفضل</label>
            <input type="date" name="date" value="<%= @booking[:date] %>"
                   min="<%= Date.current %>"
                   class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">الوقت المفضل</label>
            <input type="time" name="time" value="<%= @booking[:time] %>"
                   class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">سبب الزيارة</label>
          <textarea name="reason" rows="3" placeholder="مثال: فحص عام، ألم في المعدة…"
                    class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"><%= @booking[:reason] %></textarea>
        </div>

      </div>

      <div class="mt-6">
        <button type="submit"
                class="w-full bg-teal-600 hover:bg-teal-700 text-white px-6 py-4 rounded-2xl font-bold text-lg transition shadow-lg shadow-teal-500/30 cursor-pointer">
          📅 إرسال طلب الحجز
        </button>
      </div>

      <p class="text-xs text-slate-400 text-center mt-4">
        بإرسال الطلب، أنت توافق على أن يتم التواصل معك من قبل العيادة
      </p>

    <% end %>
  </div>

  <!-- Direct call fallback -->
  <% if @clinic.phone.present? %>
    <div class="mt-4 bg-teal-50 border border-teal-200 rounded-2xl p-4 text-center">
      <div class="text-sm text-teal-800 mb-2">أو اتصل مباشرة:</div>
      <a href="tel:<%= @clinic.phone %>"
         class="inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white px-5 py-2.5 rounded-xl font-bold transition no-underline">
        📞 <%= @clinic.phone %>
      </a>
    </div>
  <% end %>

</div>
