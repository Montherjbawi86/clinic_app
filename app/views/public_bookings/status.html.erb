<% content_for :title, "متابعة الحجز — #{@clinic.display_name}" %>

<div class="max-w-lg mx-auto p-4">

  <!-- Back link -->
  <div class="mb-6">
    <%= link_to public_clinic_path(@clinic.slug),
          class: "inline-flex items-center gap-2 text-sm text-teal-600 hover:text-teal-800 font-semibold no-underline" do %>
      ← العودة لصفحة العيادة
    <% end %>
  </div>

  <!-- Search box -->
  <div class="bg-white rounded-3xl border border-slate-200 shadow-lg p-6 mb-6">

    <div class="text-center mb-6">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center text-3xl mb-4">
        🔍
      </div>
      <h1 class="text-xl font-bold text-slate-800 mb-2">متابعة حالة الحجز</h1>
      <p class="text-sm text-slate-500">أدخل رقم الحجز المرجعي</p>
    </div>

    <%= form_with url: public_booking_status_path(@clinic.slug), method: :get do %>
      <div class="flex gap-2">
        <input type="text" name="ref" value="<%= params[:ref] %>"
               placeholder="BK-XXXXXXXX"
               dir="ltr"
               class="flex-1 border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-center font-mono tracking-wider uppercase"
               autofocus>
        <%= submit_tag "بحث",
              class: "bg-teal-600 hover:bg-teal-700 text-white px-6 py-3 rounded-xl font-bold cursor-pointer transition" %>
      </div>
    <% end %>
  </div>

  <!-- Result -->
  <% if params[:ref].present? %>

    <% if @appointment %>

      <%
        status_info = case @appointment.status
                      when "scheduled"   then ["قيد المراجعة", "bg-amber-50 text-amber-800 border-amber-200", "⏳", "سيتم التواصل معك للتأكيد"]
                      when "confirmed"   then ["مؤكد", "bg-emerald-50 text-emerald-800 border-emerald-200", "✅", "تم تأكيد الموعد — يرجى الحضور في الوقت المحدد"]
                      when "checked_in"  then ["تم الوصول", "bg-teal-50 text-teal-800 border-teal-200", "🚶", "أنت في العيادة"]
                      when "in_progress" then ["جارٍ", "bg-purple-50 text-purple-800 border-purple-200", "▶️", "الطبيب يراك الآن"]
                      when "completed"   then ["مكتمل", "bg-sky-50 text-sky-800 border-sky-200", "✔️", "تمت الزيارة"]
                      when "cancelled"   then ["ملغى", "bg-rose-50 text-rose-800 border-rose-200", "❌", "تم إلغاء هذا الحجز"]
                      when "no_show"     then ["لم تحضر", "bg-slate-50 text-slate-800 border-slate-200", "🚫", "لم يتم الحضور للموعد"]
                      else ["—", "bg-slate-50 text-slate-800 border-slate-200", "•", ""]
                      end
      %>

      <!-- Status card -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-lg overflow-hidden">
        <div class="p-6 border-b border-slate-100">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
              <div class="text-xs text-slate-500 mb-1">رقم الحجز</div>
              <div class="text-lg font-mono font-bold text-slate-800" dir="ltr">
                <%= @appointment.booking_ref %>
              </div>
            </div>
            <span class="text-sm font-bold px-4 py-2 rounded-full border-2 <%= status_info[1] %>">
              <%= status_info[2] %> <%= status_info[0] %>
            </span>
          </div>
        </div>

        <div class="p-6 space-y-3">
          <div class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">
            تفاصيل الحجز
          </div>

          <div class="flex items-center justify-between text-sm p-3 bg-slate-50 rounded-xl">
            <span class="text-slate-500">👤 المريض</span>
            <span class="font-bold text-slate-800"><%= @appointment.patient&.display_name %></span>
          </div>
          <div class="flex items-center justify-between text-sm p-3 bg-slate-50 rounded-xl">
            <span class="text-slate-500">📅 التاريخ</span>
            <span class="font-bold text-slate-800"><%= @appointment.appointment_date %></span>
          </div>
          <div class="flex items-center justify-between text-sm p-3 bg-slate-50 rounded-xl">
            <span class="text-slate-500">🕐 الوقت</span>
            <span class="font-bold text-slate-800"><%= @appointment.appointment_time&.strftime("%H:%M") %></span>
          </div>

          <% if @appointment.reason.present? %>
            <div class="p-3 bg-slate-50 rounded-xl text-sm">
              <div class="text-slate-500 mb-1">📝 السبب</div>
              <div class="font-medium text-slate-800"><%= @appointment.reason %></div>
            </div>
          <% end %>

          <!-- Status message -->
          <div class="mt-4 p-4 rounded-2xl border-2 <%= status_info[1] %> text-center">
            <div class="text-sm font-semibold">
              <%= status_info[3] %>
            </div>
          </div>

          <!-- Clinic contact -->
          <% if @clinic.phone.present? %>
            <a href="tel:<%= @clinic.phone %>"
               class="block w-full mt-4 bg-teal-600 hover:bg-teal-700 text-white text-center px-6 py-3 rounded-xl font-bold transition no-underline">
              📞 اتصل بالعيادة
            </a>
          <% end %>
        </div>
      </div>

    <% else %>

      <!-- Not found -->
      <div class="bg-white rounded-3xl border-2 border-rose-200 p-8 text-center">
        <div class="text-5xl mb-4">🔍</div>
        <h3 class="text-lg font-bold text-slate-800 mb-2">لم نجد هذا الحجز</h3>
        <p class="text-sm text-slate-500 mb-4">
          تأكد من رقم الحجز أو تواصل مع العيادة مباشرة
        </p>
        <% if @clinic.phone.present? %>
          <a href="tel:<%= @clinic.phone %>"
             class="inline-block bg-teal-600 hover:bg-teal-700 text-white px-6 py-3 rounded-xl font-bold transition no-underline">
            📞 اتصل بالعيادة
          </a>
        <% end %>
      </div>

    <% end %>

  <% end %>

</div>
