<% content_for :title, "#{t('notifications.title')} — ClinicApp" %>

<div class="max-w-3xl mx-auto space-y-4">

  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-slate-800">🔔 <%= t("notifications.title") %></h1>
    <% if current_user.notifications.unread.any? %>
      <%= button_to t("notifications.mark_all"),
            mark_all_read_notifications_path,
            method: :post,
            class: "text-sm text-teal-600 hover:text-teal-800 font-semibold cursor-pointer" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <div class="space-y-2">
      <% @notifications.each do |notification| %>
        <%= link_to notification_link_path(notification),
              class: "block p-4 rounded-xl border transition #{notification.read? ? 'bg-white border-slate-100' : 'bg-teal-50/40 border-teal-200 hover:bg-teal-50'}" do %>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center text-lg shrink-0">
              <%= notification_icon(notification) %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-slate-800">
                <%= notification_title(notification) %>
              </div>
              <div class="text-sm text-slate-500 mt-1">
                <%= notification_message(notification) %>
              </div>
              <div class="text-xs text-slate-400 mt-2">
                <%= time_ago_in_words(notification.created_at) %>
              </div>
            </div>
            <% unless notification.read? %>
              <span class="w-2 h-2 rounded-full bg-teal-500 shrink-0 mt-2"></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 text-slate-400">
      <div class="text-4xl mb-3">🔕</div>
      <p><%= t("notifications.empty") %></p>
    </div>
  <% end %>

</div>
