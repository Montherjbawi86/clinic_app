<% content_for :title, "وصفة طبية — #{@clinic.display_name}" %>

<div class="max-w-lg mx-auto p-4">

  <!-- Clinic header -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm text-center mb-4">
    <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-teal-500 to-teal-700 text-white flex items-center justify-center text-2xl font-bold mb-3">
      🏥
    </div>
    <h1 class="text-xl font-bold text-slate-800"><%= @clinic.display_name %></h1>
    <% if @clinic.address_display.present? %>
      <p class="text-sm text-slate-500 mt-1"><%= @clinic.address_display %></p>
    <% end %>
    <% if @clinic.phone.present? %>
      <a href="tel:<%= @clinic.phone %>" class="inline-flex items-center gap-1 mt-2 text-teal-600 font-semibold text-sm">
        📞 <%= @clinic.phone %>
      </a>
    <% end %>
  </div>

  <!-- Prescription info -->
  <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm mb-4">
    <div class="text-center mb-4">
      <div class="inline-block bg-teal-50 text-teal-700 px-4 py-1 rounded-full text-sm font-bold">
        وصفة طبية
      </div>
    </div>

    <div class="space-y-2 text-sm">
      <div class="flex justify-between">
        <span class="text-slate-500">المريض:</span>
        <span class="font-semibold text-slate-800"><%= @patient.display_name %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">الطبيب:</span>
        <span class="font-semibold text-slate-800">د. <%= @doctor&.name || "—" %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">التاريخ:</span>
        <span class="font-semibold text-slate-800"><%= @appointment.appointment_date %></span>
      </div>
      <% if @patient.age.present? || @patient.age_from_dob.present? %>
        <div class="flex justify-between">
          <span class="text-slate-500">العمر:</span>
          <span class="font-semibold text-slate-800"><%= @patient.age.presence || @patient.age_from_dob %> سنة</span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Medications -->
  <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm mb-4">
    <h2 class="font-bold text-slate-800 mb-4">💊 الأدوية الموصوفة</h2>

    <% if @medications.any? %>
      <ul class="space-y-3">
        <% @medications.each_with_index do |m, i| %>
          <li class="border border-slate-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-sm shrink-0">
                <%= i + 1 %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="font-bold text-slate-800 text-lg"><%= m.display_name %></div>
                <div class="grid grid-cols-2 gap-2 mt-2 text-sm">
                  <div>
                    <div class="text-xs text-slate-500">الجرعة</div>
                    <div class="font-semibold text-slate-700"><%= m.dosage %></div>
                  </div>
                  <% if m.frequency.present? %>
                    <div>
                      <div class="text-xs text-slate-500">التكرار</div>
                      <div class="font-semibold text-slate-700"><%= m.frequency %></div>
                    </div>
                  <% end %>
                  <% if m.duration.present? %>
                    <div>
                      <div class="text-xs text-slate-500">المدة</div>
                      <div class="font-semibold text-slate-700"><%= m.duration %></div>
                    </div>
                  <% end %>
                  <% if m.route.present? %>
                    <div>
                      <div class="text-xs text-slate-500">طريقة الاستخدام</div>
                      <div class="font-semibold text-slate-700"><%= t("medications.routes.#{m.route}", default: m.route) %></div>
                    </div>
                  <% end %>
                </div>
                <% if m.instructions.present? %>
                  <div class="mt-3 p-3 bg-amber-50 rounded-lg text-sm text-amber-800">
                    <span class="font-semibold">💡 تعليمات:</span>
                    <%= m.instructions %>
                  </div>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-center text-slate-500 text-sm py-4">لا توجد أدوية موصوفة</p>
    <% end %>
  </div>

  <!-- Diagnosis if available -->
  <% if @appointment.respond_to?(:visit_notes) && @appointment.visit_notes.present? %>
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm mb-4">
      <h2 class="font-bold text-slate-800 mb-2">📝 ملاحظات الطبيب</h2>
      <p class="text-sm text-slate-700 whitespace-pre-wrap"><%= @appointment.visit_notes %></p>
    </div>
  <% end %>

  <!-- Call-to-action -->
  <div class="bg-teal-50 border border-teal-200 rounded-2xl p-5 text-center">
    <div class="text-sm text-teal-800 mb-3">
      لأي استفسار عن الوصفة، تواصل مع العيادة
    </div>
    <% if @clinic.phone.present? %>
      <a href="tel:<%= @clinic.phone %>"
         class="inline-flex items-center gap-2 bg-teal-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-teal-700">
        📞 اتصل بالعيادة
      </a>
    <% end %>
  </div>

  <!-- Footer -->
  <div class="text-center mt-6 text-xs text-slate-400">
    هذه الوصفة صادرة إلكترونياً من نظام ClinicApp
    <div class="mt-1">رقم الوصفة: #<%= @appointment.id.to_s.rjust(6, "0") %></div>
  </div>

</div>
